// the digits of a.
const LG1P_H: f64[13] = [
    -0.5772156649015329, 0.8224670334241132, -0.40068563438653143, 0.27058080842778454, -0.20738555102867398, 0.1695571769974082, -0.1440498967688461, 0.12550966952474304, -0.11133426586956469, 0.1000994575127818, -0.09095401714582904, 0.083353840546109, -0.0769325164113522,
];
const LG1P_L: f64[13] = [
    4.942915152430645e-18, 1.520336175199238e-17, 2.250747042487504e-18, 1.1871280107138412e-17, -4.099767328621813e-18, 2.2393851330167238e-18, -9.623140085232555e-18, -2.5214685384672305e-18, -4.643990572582924e-18, 2.6102404859583283e-18, -8.306705457691885e-19, 2.963832603652642e-19, 3.2900356019181198e-18,
];

// ---- the layer of pairs of doubles -----------------------------------

// One pair holds a value with about 30 digits. hi carries the value and
// lo carries the rest.
struct DD { hi: f64, lo: f64 }

// The smallest normal value. A pair below it can still round to a
// subnormal result once.
const MIN_NORMAL: f64 = 2.2250738585072014e-308;

// The exact sum of two values. The pair p and e adds up to a + b.
fn two_sum(a: f64, b: f64) -> f64, f64 {
    let s = a + b;
    let bb = s - a;
    return s, (a - (s - bb)) + (b - bb);
}

fn dd_from(x: f64) -> DD { return DD { hi: x, lo: 0.0 }; }
fn dd_to_f64(a: DD) -> f64 { return a.hi + a.lo; }

fn dd_add(a: DD, b: DD) -> DD {
    let s, e = two_sum(a.hi, b.hi);
    if is_inf(s) { return DD { hi: s, lo: 0.0 }; }
    let t = e + a.lo + b.lo;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_add_d(a: DD, b: f64) -> DD {
    let s, e = two_sum(a.hi, b);
    if is_inf(s) { return DD { hi: s, lo: 0.0 }; }
    let t = e + a.lo;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_sub(a: DD, b: DD) -> DD {
    return dd_add(a, DD { hi: -b.hi, lo: -b.lo });
}

fn dd_neg(a: DD) -> DD { return DD { hi: -a.hi, lo: -a.lo }; }

fn dd_mul(a: DD, b: DD) -> DD {
    let p, e = two_prod(a.hi, b.hi);
    if is_inf(p) { return DD { hi: p, lo: 0.0 }; }
    let t = e + a.hi * b.lo + a.lo * b.hi;
    let h, l = two_sum(p, t);
    return DD { hi: h, lo: l };
}

fn dd_mul_d(a: DD, b: f64) -> DD {
    let p, e = two_prod(a.hi, b);
    if is_inf(p) { return DD { hi: p, lo: 0.0 }; }
    let t = e + a.lo * b;
    let h, l = two_sum(p, t);
    return DD { hi: h, lo: l };
}

fn dd_div(a: DD, b: DD) -> DD {
    let q1 = a.hi / b.hi;
    if is_inf(q1) { return DD { hi: q1, lo: 0.0 }; }
    var r = dd_sub(a, dd_mul(b, dd_from(q1)));
    let q2 = r.hi / b.hi;
    r = dd_sub(r, dd_mul(b, dd_from(q2)));
    let q3 = r.hi / b.hi;
    let s, e = two_sum(q1, q2);
    let t = e + q3 + r.lo / b.hi;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_div_d(a: DD, b: f64) -> DD { return dd_div(a, dd_from(b)); }

fn dd_sqrt(a: DD) -> DD {
    let x = sqrt(a.hi);
    let r = dd_sub(a, dd_mul(dd_from(x), dd_from(x)));
    let h, l = two_sum(x, r.hi / (2.0 * x));
    return DD { hi: h, lo: l };
}

// The value 2^k for a fixed range of k. The power call is exact for the
// powers of two, which the probes proved on both versions.
fn pow2_int(k: i64) -> f64 {
    if k < -1080 { return 0.0; }
    if k > 1080 { return 1.0 / 0.0; }
    return pow(2.0, k as f64);
}

// The pair m and e with x = m * 2^e and m in [1, 2) or m equal 0. The
// search runs on ten scale factors, so it ends in ten steps.
const EXP2_FACTORS: f64[10] = [
    1.3407807929942597e+154, 1.157920892373162e+77, 3.402823669209385e+38,
    1.8446744073709552e+19, 4294967296.0, 65536.0,
    256.0, 16.0, 4.0, 2.0,
];

fn frexp2(x: f64) -> f64, i64 {
    var m = x;
    var e: i64 = 0;
    if m != 0.0 && abs(m) < MIN_NORMAL {
        m = m * 18014398509481984.0;
        e = -54;
    }
    var k: i64 = 512;
    for f in EXP2_FACTORS {
        if abs(m) >= f {
            m = m / f;
            e += k;
        } else if abs(m) < 1.0 && abs(m) * f < 2.0 {
            m = m * f;
            e -= k;
        }
        k = k / 2;
    }
    return m, e;
}

// The value of the pair scaled by 2^k, rounded once.
fn dd_scale(a: DD, k: i64) -> f64 {
    return dd_to_f64(a) * pow2_int(k);
}

// The value of the pair scaled by 2^k, kept as a pair.
fn dd_scale_dd(a: DD, k: i64) -> DD {
    if k < -1180 { return dd_from(0.0); }
    let s = pow2_int(k);
    return DD { hi: a.hi * s, lo: a.lo * s };
}
// ---- input checks ----------------------------------------------------

// The checks of one argument. A NaN gives the NaN code, an infinity the
// infinity code. The order of the checks never changes.
fn check_scalar(x: f64) -> i64 {
    if is_nan(x) { return ERR_NAN; }
    if is_inf(x) { return ERR_INFINITY; }
    return OK;
}

// The checks of a shape. A shape at or below 0 is out of range.
fn check_shape(a: f64) -> i64 {
    if is_nan(a) { return ERR_NAN; }
    if is_inf(a) { return ERR_INFINITY; }
    if a <= 0.0 { return ERR_DOMAIN; }
    return OK;
}

// The checks of a probability. The end points 0 and 1 are valid inputs.
fn check_prob(p: f64) -> i64 {
    if is_nan(p) { return ERR_NAN; }
    if is_inf(p) { return ERR_DOMAIN; }
    if p < 0.0 || p > 1.0 { return ERR_DOMAIN; }
    return OK;
}

// ---- polynomial helpers ----------------------------------------------

// The Horner form of a coefficient table, highest coefficient first.
fn horner(c: const f64[:], z: f64) -> f64 {
    var r: f64 = 0.0;
    var i = c.len - 1;
    while i >= 0 {
        r = r * z + c[i];
        i -= 1;
    }
    return r;
}

// The Clenshaw form of a Chebyshev fit, highest coefficient first.
fn clenshaw(c: const f64[:], t: f64) -> f64 {
    var b1: f64 = 0.0;
    var b2: f64 = 0.0;
    var i = c.len - 1;
    while i >= 1 {
        let b0 = 2.0 * t * b1 - b2 + c[i];
        b2 = b1;
        b1 = b0;
        i -= 1;
    }
    return t * b1 - b2 + c[0];
}

// ---- the error function family ---------------------------------------

// The erfc core for x below 0.5: one minus the series of the erf.
fn erf_series(x: f64) -> f64 {
    return x * horner(ERF_SERIES, x * x);
}

// q(x) = exp(x^2) erfc(x), for 0.5 <= x < 28. One fit per range, and the
// asymptotic series above 7.
fn scaled_q(x: f64) -> f64 {
    if x < 1.5 {
        return clenshaw(H1_CHEB, 2.0 * x - 2.0);
    }
    if x < 3.0 {
        return clenshaw(H2_CHEB, (4.0 * x - 9.0) / 3.0);
    }
    if x < 7.0 {
        return clenshaw(G_CHEB, (2.0 * x - 10.0) / 4.0) / x * INV_SQRT_PI;
    }
    return horner(ASYM_COEF, -0.5 / (x * x)) / x * INV_SQRT_PI;
}

// The erfc core for 0.5 <= x < 28. The split of x*x keeps the digits of
// the exponential, so the far tail holds its relative accuracy.
fn erfc_pos(x: f64) -> f64 {
    let hi, lo = two_prod(x, x);
    var q = scaled_q(x);
    q = q - q * lo;
    return q * exp(-hi);
}

// The error function of one value.
fn erf(x: f64) -> f64, i64 {
    if is_nan(x) { return nan(), ERR_NAN; }
    if is_inf(x) {
        if x > 0.0 { return 1.0, OK; }
        return -1.0, OK;
    }
    let ax = abs(x);
    var r: f64 = 0.0;
    if ax <= 0.5 {
        r = erf_series(ax);
    } else if ax < 28.0 {
        r = 1.0 - erfc_pos(ax);
    } else {
        r = 1.0;
    }
    if x < 0.0 { r = -r; }
    return r, OK;
}

// The complementary error function. The call never forms one minus the
// erf above 0.5, where that form loses every digit.
fn erfc(x: f64) -> f64, i64 {
    if is_nan(x) { return nan(), ERR_NAN; }
    if is_inf(x) {
        if x > 0.0 { return 0.0, OK; }
        return 2.0, OK;
    }
    if abs(x) <= 0.5 {
        return 1.0 - erf_series(x), OK;
    }
    if x > 27.25 { return 0.0, OK; }
    if x < -27.25 { return 2.0, OK; }
    if x > 0.0 { return erfc_pos(x), OK; }
    return 2.0 - erfc_pos(-x), OK;
}

// The start value of the inverse, from the form of Winitzki. The input
// is log(1 - y*y), never above 0.
fn winitzki(lg: f64) -> f64 {
    let b = 2.0 / (PI * 0.147) + 0.5 * lg;
    let eps = -lg / 0.147;
    var d: f64 = 0.0;
    if b > 0.0 {
        d = eps / (sqrt(b * b + eps) + b);
    } else {
        d = sqrt(b * b + eps) - b;
    }
    return sqrt(d);
}

// The inverse core for a probability p in (0, 0.5]. Above 1e-3 the steps
// refine the erfc. Below 1e-3 the steps refine the log of the erfc, so
// the far tail never forms a subnormal value.
fn erfcinv_core(p: f64) -> f64 {
    var x = winitzki(log(p * (2.0 - p)));
    if p >= 1e-3 {
        var i: i64 = 0;
        while i < 3 {
            let g = erfc(x) - p;
            let d = -TWO_OVER_SQRT_PI * exp(-x * x);
            let u = g / d;
            x = x - u / (1.0 + x * u);
            i += 1;
        }
        return x;
    }
    let lp = log(p);
    var i: i64 = 0;
    while i < 3 {
        let hi, lo = two_prod(x, x);
        let q = scaled_q(x);
        let h = (-hi - lp) + (log(q) - lo);
        let hp = -TWO_OVER_SQRT_PI / q;
        let u = h / hp;
        x = x - u / (1.0 + u * (x + 0.5 * hp));
        i += 1;
    }
    return x;
}

// The inverse erf for a value in (0, 0.5].
fn erfinv_core(y: f64) -> f64 {
    if y < 1e-8 {
        return HALF_SQRT_PI * y * (1.0 + PI_OVER_12 * y * y);
    }
    var x = winitzki(log1p_core(-y * y));
    var i: i64 = 0;
    while i < 3 {
        let g = erf_core(x) - y;
        let d = TWO_OVER_SQRT_PI * exp(-x * x);
        let u = g / d;
        x = x - u / (1.0 + x * u);
        i += 1;
    }
    return x;
}

// The core of the erf without the checks, for the steps above.
fn erf_core(x: f64) -> f64 {
    let ax = abs(x);
    var r: f64 = 0.0;
    if ax <= 0.5 {
        r = erf_series(ax);
    } else if ax < 28.0 {
        r = 1.0 - erfc_pos(ax);
    } else {
        r = 1.0;
    }
    if x < 0.0 { r = -r; }
    return r;
}

// The inverse of the error function. The range is the open interval from
// -1 to 1. The end points give the overflow code.
fn erfinv(y: f64) -> f64, i64 {
    let c = check_scalar(y);
    if c != 0 { return nan(), c; }
    if y > 1.0 || y < -1.0 { return nan(), ERR_DOMAIN; }
    let a = abs(y);
    if a == 1.0 { return nan(), ERR_OVERFLOW; }
    if a == 0.0 { return y, OK; }
    var r: f64 = 0.0;
    if a <= 0.5 {
        r = erfinv_core(a);
    } else {
        r = erfcinv_core(1.0 - a);
    }
    if y < 0.0 { r = -r; }
    return r, OK;
}

// The inverse of the erfc. The range runs from 0 to 2. The end points
// give the overflow code.
fn erfcinv(p: f64) -> f64, i64 {
    let c = check_scalar(p);
    if c != 0 { return nan(), c; }
    if p < 0.0 || p > 2.0 { return nan(), ERR_DOMAIN; }
    if p == 0.0 || p == 2.0 { return nan(), ERR_OVERFLOW; }
    if p <= 0.5 { return erfcinv_core(p), OK; }
    if p < 1.5 {
        let t = 1.0 - p;
        if t > 0.0 { return erfinv_core(t), OK; }
        if t < 0.0 { return -erfinv_core(-t), OK; }
        return 0.0, OK;
    }
    return -erfcinv_core(2.0 - p), OK;
}

// ---- the accurate log1p and expm1 ------------------------------------

// The log of one plus x. The two sum holds 1 + x exactly, so the small x
// keeps its digits.
fn log1p_core(x: f64) -> f64 {
    let u, e = two_sum(1.0, x);
    return log(u) + e / u;
}

fn log1p(x: f64) -> f64, i64 {
    let c = check_scalar(x);
    if c != 0 { return nan(), c; }
    if x < -1.0 { return nan(), ERR_DOMAIN; }
    if x == -1.0 { return nan(), ERR_OVERFLOW; }
    let r = log1p_core(x);
    if is_inf(r) { return nan(), ERR_OVERFLOW; }
    return r, OK;
}

fn expm1_core(x: f64) -> f64 {
    let k = floor(x * INV_LN2 + 0.5);
    let r = (x - k * LN2_HI) - k * LN2_LO;
    let p = r + r * r * horner(EXPM1_SERIES, r);
    if k == 0.0 { return p; }
    let s, e = two_sum(1.0, p);
    let ik = k as i64;
    if k > 0.0 {
        let t = (s * pow2_int(ik - 1)) * 2.0 - 1.0;
        return t + (e * pow2_int(ik - 1)) * 2.0;
    }
    return s * pow2_int(ik) - 1.0 + e * pow2_int(ik);
}

fn expm1(x: f64) -> f64, i64 {
    let c = check_scalar(x);
    if c != 0 { return nan(), c; }
    if x > 709.782712893384 { return nan(), ERR_OVERFLOW; }
    if x < -40.0 { return -1.0, OK; }
    let r = expm1_core(x);
    if is_inf(r) { return nan(), ERR_OVERFLOW; }
    return r, OK;
}

// ---- the gamma family ------------------------------------------------

// The scale factor of the compensated product. The product of the core
// scales down by 2^-500 when it passes this value.
const BIGP: f64 = 3.273390607896142e+150;

// The gamma core on the range from 1 to 2. The fit has 24 terms.
fn gamma_core_fit(f: f64) -> f64 {
    return clenshaw(GAMMA_C, 2.0 * f - 3.0);
}

// The product gamma(1 + f) = gamma(f) * f * (f + 1) * ... for f in [1, 2)
// and k factors more. The result is m * 2^e. The pair of doubles keeps
// the digits of the product, and the exponent keeps the range.
fn gamma_core(k: f64, f: f64) -> f64, i64 {
    let n = k + 1.0;
    var ph = gamma_core_fit(f);
    var pl: f64 = 0.0;
    var e: i64 = 0;
    var j: f64 = 0.0;
    while j < n - 1.0 {
        let s, se = two_sum(f, j);
        let p, q0 = two_prod(ph, s);
        let q = q0 + (ph * se + pl * s);
        let h, l = two_sum(p, q);
        ph = h;
        pl = l;
        if ph > BIGP {
            ph *= 3.054936363499605e-151;
            pl *= 3.054936363499605e-151;
            e += 500;
        }
        j += 1.0;
    }
    return ph + pl, e;
}

// The gamma of x at or above 1. The value comes back as m * 2^e.
fn gamma_scaled(x: f64) -> f64, i64 {
    let n = floor(x);
    return gamma_core(n - 1.0, x - n + 1.0);
}

// The value m * 2^e with e a multiple of 500, scaled back up.
fn mulp(m: f64, e: i64) -> f64 {
    var r = m;
    var t = e;
    while t > 0 {
        r = r * BIGP;
        t -= 500;
    }
    return r;
}

fn divp(m: f64, e: i64) -> f64 {
    var r = m;
    var t = e;
    while t > 0 {
        r = r / BIGP;
        t -= 500;
    }
    return r;
}

// The sign of the gamma of a negative non integer x. It is +1 when the
// integer part below x is even, and -1 when it is odd.
fn gamma_sign(n: f64) -> f64 {
    let i = n as i64;
    if i % 2 == 0 { return 1.0; }
    return -1.0;
}

// The gamma function. The poles give the undefined code. A result that
// does not fit gives the overflow code. The reflection covers the
// negative side, and the far negative side runs in the log domain.
fn gamma(x: f64) -> f64, i64 {
    if is_nan(x) { return nan(), 3; }
    if is_inf(x) { return nan(), 8; }
    if x == 0.0 || (x < 0.0 && x == floor(x)) { return nan(), 7; }
    if x >= 1.0 {
        if x > 171.6243769563027 { return nan(), 8; }
        let m, e = gamma_scaled(x);
        let r = mulp(m, e);
        if is_inf(r) { return nan(), 8; }
        return r, 0;
    }
    if x > 0.0 {
        let m, e = gamma_scaled(x + 1.0);
        let r = m / x;
        if is_inf(r) || is_nan(r) { return nan(), 8; }
        return r, 0;
    }
    let n = floor(x);
    let f0 = x - n;
    var f = f0;
    if f > 0.5 { f = n + 1.0 - x; }
    let s = sin(PI * f);
    let sg = gamma_sign(n);
    if x < -201.0 {
        let lv, lc = lgamma_pos(1.0 - x);
        if lc != 0 { return nan(), lc; }
        let r = exp(log(PI / abs(s)) - lv);
        return sg * r, 0;
    }
    var m: f64 = 0.0;
    var e: i64 = 0;
    if n == -1.0 {
        let m2, e2 = gamma_scaled(1.0 - x);
        m = m2;
        e = e2;
    } else {
        let m2, e2 = gamma_core(-n - 1.0, 2.0 - f0);
        m = m2;
        e = e2;
    }
    var r = PI / (s * m);
    r = divp(r, e);
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return sg * r, 0;
}

// The log gamma of a positive x. The fit covers the range from 0.5 to 3,
// the scaled product covers the range from 3 to 15, and the Stirling
// series covers the rest.
recursive fn lgamma_pos(x: f64) -> f64, i64 {
    if x < 0.5 {
        let v, c = lgamma_pos(x + 1.0);
        if c != 0 { return nan(), c; }
        return v - log(x), 0;
    }
    if x <= 3.0 {
        if x == 1.0 || x == 2.0 { return 0.0, 0; }
        return clenshaw(LGAMMA_C, (2.0 * x - 3.5) / 2.5) * ((x - 1.0) * (x - 2.0)), 0;
    }
    if x < 15.0 {
        let m, e = gamma_scaled(x);
        if e != 0 { return nan(), 8; }
        let r = log(m);
        if is_inf(r) || is_nan(r) { return nan(), 8; }
        return r, 0;
    }
    let z = 1.0 / (x * x);
    var s: f64 = 0.0;
    var i = STIR_C.len - 1;
    while i >= 0 {
        s = s * z + STIR_C[i];
        i -= 1;
    }
    let r = (x - 0.5) * log(x) - x + 0.9189385332046727 + s / x;
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return r, 0;
}

// The log of the absolute value of the gamma, with the sign. The sign is
// +1 or -1, and 0 on a fault.
fn lgamma(x: f64) -> f64, f64, i64 {
    if is_nan(x) { return nan(), 0.0, 3; }
    if is_inf(x) { return nan(), 0.0, 8; }
    if x == 0.0 || (x < 0.0 && x == floor(x)) { return nan(), 0.0, 7; }
    if x > 0.0 {
        let v, c = lgamma_pos(x);
        if c != 0 { return nan(), 0.0, c; }
        return v, 1.0, 0;
    }
    let n = floor(x);
    // the distance to the nearest integer, exact for a tiny x
    var f = x - n;
    if f > 0.5 { f = n + 1.0 - x; }
    let s = abs(sin(PI * f));
    let sg = gamma_sign(n);
    let y = 1.0 - x;
    let v, c = lgamma_pos(y);
    if c != 0 { return nan(), 0.0, c; }
    return log(PI / s) - v, sg, 0;
}

// The digamma of a positive x. The fit around the root covers the range
// from 1 to 3, a second fit covers the range from 3 to 10, and the
// asymptotic series covers the rest.
recursive fn digamma_pos(x: f64) -> f64, i64 {
    if x >= 10.0 {
        let z = 1.0 / (x * x);
        var s: f64 = 0.0;
        var i = DIG_ASY.len - 1;
        while i >= 0 {
            s = s * z + DIG_ASY[i];
            i -= 1;
        }
        return log(x) - 0.5 / x - s * z, 0;
    }
    if x < 1.0 {
        let v, c = digamma_pos(x + 1.0);
        if c != 0 { return nan(), c; }
        return v - 1.0 / x, 0;
    }
    if x <= 3.0 {
        let d = (x - X0_HI) - X0_LO;
        return clenshaw(DIG_C, x - 2.0) * d, 0;
    }
    return clenshaw(DIG2_C, (2.0 * x - 13.0) / 7.0), 0;
}

// The digamma function. The poles give the undefined code.
fn digamma(x: f64) -> f64, i64 {
    if is_nan(x) { return nan(), 3; }
    if is_inf(x) { return nan(), 8; }
    if x == 0.0 || (x < 0.0 && x == floor(x)) { return nan(), 7; }
    if x > 0.0 {
        return digamma_pos(x);
    }
    let n = floor(x);
    let f = x - n;
    var c: f64 = 0.0;
    if f <= 0.5 {
        c = 1.0 / tan(PI * f);
    } else {
        c = -1.0 / tan(PI * (1.0 - f));
    }
    let v, cv = digamma_pos(1.0 - x);
    if cv != 0 { return nan(), cv; }
    let r = v - PI * c;
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return r, 0;
}

// ---- the log and the exponential of pairs ---------------------------

// The logarithm of a positive value, as a pair. The series of the area
// hyperbolic tangent runs on the pair z, and the exponent of two comes
// back through the log of 2.
const LOG_SERIES_TERMS: i64 = 24;

fn dd_log_d(x: f64) -> DD {
    if x <= 0.0 { return dd_from(0.0 / 0.0); }
    var m: f64 = 0.0;
    var e: i64 = 0;
    let m2, e2 = frexp2(x);
    m = m2;
    e = e2;
    if m > 1.4142135623730951 {
        m = m * 0.5;
        e += 1;
    }
    let ms, me = two_sum(m, 1.0);
    let z = dd_div(dd_from(m - 1.0), DD { hi: ms, lo: me });
    let z2 = dd_mul(z, z);
    var term = z;
    var total = z;
    var k: i64 = 1;
    while k < LOG_SERIES_TERMS {
        term = dd_mul(term, z2);
        total = dd_add(total, dd_div_d(term, 2.0 * k + 1.0));
        k += 1;
    }
    let log_m = dd_mul_d(total, 2.0);
    let ln2 = DD { hi: DD_LN2_HI, lo: DD_LN2_LO };
    return dd_add(log_m, dd_mul_d(ln2, e));
}

// The logarithm of a pair. The base comes from the one value form, and
// the second member adds a correction of the first order.
fn dd_log(a: DD) -> DD {
    if a.hi <= 0.0 { return dd_from(0.0 / 0.0); }
    let base = dd_log_d(a.hi);
    if a.lo == 0.0 { return base; }
    let t = a.lo / a.hi;
    return dd_add(base, dd_from(t - 0.5 * t * t));
}

// The exponential of a pair, as a pair and a power of two. The split
// keeps the scaling out of the series, so a subnormal result rounds once.
fn dd_exp_parts(a: DD) -> DD, i64 {
    let k = floor(a.hi / DD_LN2_HI + 0.5) as i64;
    let ln2 = DD { hi: DD_LN2_HI, lo: DD_LN2_LO };
    var r = dd_sub(a, dd_mul_d(ln2, k));
    r = dd_mul_d(r, 0.0625);
    var term = dd_from(1.0);
    var total = dd_from(1.0);
    var n: i64 = 1;
    while n < 16 {
        term = dd_div_d(dd_mul(term, r), n);
        total = dd_add(total, term);
        n += 1;
    }
    var i: i64 = 0;
    while i < 4 {
        total = dd_mul(total, total);
        i += 1;
    }
    return total, k;
}

fn dd_exp(a: DD) -> DD {
    let m, k = dd_exp_parts(a);
    return dd_scale_dd(m, k);
}

// The shift of the Stirling series. Arguments below it move up first,
// and the logs of the shifts come back off.
const STIRLING_SHIFT: f64 = 16.0;

// The log gamma of a positive pair. The Stirling series of 14 pairs
// covers the range from 16 up, and the shift covers the range below.
recursive fn dd_lngamma(z: DD) -> DD {
    if z.hi < STIRLING_SHIFT {
        let n = (floor(STIRLING_SHIFT - z.hi) + 1.0) as i64;
        var acc = dd_lngamma(dd_add_d(z, n));
        var i: i64 = 0;
        while i < n {
            acc = dd_sub(acc, dd_log(dd_add_d(z, i)));
            i += 1;
        }
        return acc;
    }
    let t1 = dd_mul(dd_log(z), dd_sub(z, dd_from(0.5)));
    var acc = dd_sub(t1, z);
    acc = dd_add(acc, dd_mul_d(DD { hi: LN2PI_H, lo: LN2PI_L }, 0.5));
    let zinv = dd_div(dd_from(1.0), z);
    let zinv2 = dd_mul(zinv, zinv);
    var term = zinv;
    var i: i64 = 0;
    while i < STIR_H.len {
        acc = dd_add(acc, dd_mul(term, DD { hi: STIR_H[i], lo: STIR_L[i] }));
        term = dd_mul(term, zinv2);
        i += 1;
    }
    return acc;
}

// The log of the beta function of two pairs. The two log gamma terms
// cancel, so the plain form loses the digits of the small shapes, and the
// pair form does not. A shape of 1e8 or more would lose its digits to the
// size of the log gamma terms, and 1e150 would overflow them. Those shapes
// take the difference of the Stirling forms, which holds only ratios.
// The product of two pairs when the first is as large as 1e308. The split
// of the two product overflows above 1e300, so the first factor goes down
// by 2^200 and the product comes back.
fn dd_mul_big(a: DD, b: DD) -> DD {
    if abs(a.hi) < 1e280 { return dd_mul(a, b); }
    return dd_scale_dd(dd_mul(dd_scale_dd(a, -200), b), 200);
}

// The ratio of two pairs of the same size, safe for a size of 1e308.
fn dd_ratio_big(a: DD, b: DD) -> DD {
    if abs(b.hi) < 1e280 { return dd_div(a, b); }
    return dd_div(dd_scale_dd(a, -200), dd_scale_dd(b, -200));
}

fn dd_lnbeta_dd(a: DD, b: DD) -> DD {
    let s = dd_add(a, b);
    var lo = a;
    var hi = b;
    if a.hi > b.hi {
        lo = b;
        hi = a;
    }
    if hi.hi < 1e8 {
        return dd_sub(dd_add(dd_lngamma(a), dd_lngamma(b)), dd_lngamma(s));
    }
    let half_ln2pi = DD { hi: HALF_LN2PI_H, lo: HALF_LN2PI_L };
    var ls = dd_log(s);
    if hi.hi >= 1e280 {
        // the sum may not fit in a double: take the log of the sum over 2^200
        let ss = dd_add(dd_scale_dd(lo, -200), dd_scale_dd(hi, -200));
        ls = dd_add(dd_log(ss), dd_mul_d(DD { hi: DD_LN2_HI, lo: DD_LN2_LO }, 200.0));
    }
    let l1 = dd_log1p_dd(dd_ratio_big(lo, hi));
    if lo.hi >= 20.0 {
        // ln(hi / s) is minus log1p(lo / hi): the plain difference of the logs loses it
        let ll = dd_log(lo);
        var t = dd_sub(dd_mul_big(lo, dd_sub(ll, ls)), dd_mul_big(hi, l1));
        t = dd_sub(t, dd_mul_d(dd_sub(ll, l1), 0.5));
        t = dd_add(t, half_ln2pi);
        let sm = dd_sub(dd_add(dd_stirling_sum(a.hi), dd_stirling_sum(b.hi)), dd_stirling_sum(a.hi + b.hi));
        return dd_add(t, sm);
    }
    // the small shape keeps its exact log gamma
    let t1 = dd_mul_big(dd_add_d(hi, -0.5), l1);
    var t = dd_sub(lo, dd_add(t1, dd_mul(lo, ls)));
    t = dd_add(t, dd_lngamma(lo));
    return dd_add(t, dd_sub(dd_stirling_sum(hi.hi), dd_stirling_sum(a.hi + b.hi)));
}

fn dd_lnbeta(a: f64, b: f64) -> DD {
    return dd_lnbeta_dd(dd_from(a), dd_from(b));
}

// ---- beta, lbeta and lchoose ----------------------------------------

fn lbeta(a: f64, b: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    let cb = check_shape(b);
    if cb != 0 { return nan(), cb; }
    let r = dd_scale(dd_lnbeta(a, b), 0);
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return r, 0;
}

fn beta(a: f64, b: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    let cb = check_shape(b);
    if cb != 0 { return nan(), cb; }
    let lnb = dd_lnbeta(a, b);
    if lnb.hi > 709.9 { return nan(), 8; }
    // below the smallest subnormal the true value is zero
    if lnb.hi < -745.3 { return 0.0, 0; }
    let m, k = dd_exp_parts(lnb);
    let r = dd_scale(m, k);
    if is_inf(r) { return nan(), 8; }
    return r, 0;
}

// The log of the binomial coefficient. The end points give the exact 0.
// The log of the binomial coefficient as a pair.
fn dd_lchoose(n: f64, k: f64) -> DD {
    if k == 0.0 || k == n { return dd_from(0.0); }
    // C(n, k) = 1 / ((n + 1) B(k + 1, n - k + 1))
    let k1 = dd_add_d(dd_from(k), 1.0);
    let nk1 = dd_add_d(dd_sub(dd_from(n), dd_from(k)), 1.0);
    return dd_neg(dd_add(dd_log(dd_add_d(dd_from(n), 1.0)), dd_lnbeta_dd(k1, nk1)));
}

fn lchoose(n: f64, k: f64) -> f64, i64 {
    let cn = check_scalar(n);
    if cn != 0 { return nan(), cn; }
    let ck = check_scalar(k);
    if ck != 0 { return nan(), ck; }
    if n < 0.0 || k < 0.0 || k > n { return nan(), 5; }
    if k == 0.0 || k == n { return 0.0, 0; }
    let r = dd_to_f64(dd_lchoose(n, k));
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return r, 0;
}

// ---- the layer of the incomplete gamma -------------------------------

// log(1 + x) - x as a pair, from the series of 40 pairs. The small
// forms of the prefactor need it.
fn dd_log1pmx(x: DD) -> DD {
    if abs(x.hi) > 0.5 {
        return dd_sub(dd_log(dd_add(dd_from(1.0), x)), x);
    }
    var p = DD { hi: LOG1PMX_H[LOG1PMX_H.len - 1], lo: LOG1PMX_L[LOG1PMX_L.len - 1] };
    var j = LOG1PMX_H.len - 2;
    while j >= 0 {
        p = dd_add(dd_mul(p, x), DD { hi: LOG1PMX_H[j], lo: LOG1PMX_L[j] });
        j -= 1;
    }
    return dd_mul(p, dd_mul_d(dd_mul(x, x), -0.5));
}

// psi(delta) = delta - ln(1 + delta) as a pair. It is positive on both
// sides of 0.
fn dd_psi(delta: DD) -> DD {
    if abs(delta.hi) <= 0.5 {
        return dd_neg(dd_log1pmx(delta));
    }
    return dd_sub(delta, dd_log(dd_add(dd_from(1.0), delta)));
}

// The Stirling remainder S(a) = ln Gamma(a+1) - [(a+1/2) ln a - a +
// ln(2 pi)/2]. The series of pairs covers the range from 20 up, and the
// exact log gamma covers the range below.
fn dd_stirling_sum(a: f64) -> DD {
    // the sum is below 1e-101 here
    if a >= 1e100 { return dd_from(0.0); }
    var p = dd_from(0.0);
    let inv = dd_div_d(dd_from(1.0), a);
    let inv2 = dd_mul(inv, inv);
    var i = STIR_H.len - 1;
    while i >= 0 {
        p = dd_add(dd_mul(p, inv2), DD { hi: STIR_H[i], lo: STIR_L[i] });
        i -= 1;
    }
    return dd_mul(p, inv);
}

fn dd_stirling_s(a: f64) -> DD {
    if a >= 20.0 {
        return dd_stirling_sum(a);
    }
    let lg = dd_lngamma(dd_add_d(dd_from(a), 1.0));
    let ln_a = dd_log_d(a);
    let base = dd_add(dd_sub(dd_mul(dd_add_d(dd_from(a), 0.5), ln_a), dd_from(a)), DD { hi: HALF_LN2PI_H, lo: HALF_LN2PI_L });
    return dd_sub(lg, base);
}

// The log of x^a exp(-x) / Gamma(a+1). The large terms cancel in this
// form, so nothing is lost for a shape near the argument.
fn dd_log_prefactor(a: f64, x: f64) -> DD {
    // The form with the ratio x / a loses x when x is far below a, and it
    // overflows when a is tiny or x is huge. The direct form has neither
    // fault, because no large terms cancel there.
    if a < 1e-30 || x < 0.5 * a || x > 1e6 * a {
        let lg = dd_lngamma(dd_add_d(dd_from(a), 1.0));
        return dd_sub(dd_sub(dd_mul_d(dd_log_d(x), a), dd_from(x)), lg);
    }
    let delta = dd_div_d(dd_sub(dd_from(x), dd_from(a)), a);
    var t: DD = dd_from(0.0);
    if abs(delta.hi) <= 0.5 {
        t = dd_mul_d(dd_log1pmx(delta), a);
    } else {
        t = dd_mul_d(dd_sub(dd_log(dd_add(dd_from(1.0), delta)), delta), a);
    }
    let ln_a = dd_log_d(a);
    let half = dd_mul_d(dd_add(ln_a, DD { hi: LN2PI_H, lo: LN2PI_L }), 0.5);
    return dd_add(dd_sub(t, half), dd_neg(dd_stirling_s(a)));
}

// The sum of the power series of the lower tail, as a pair. The sum
// stays a pair so the complement keeps its own digits.
fn series_p(a: f64, x: f64) -> DD, i64 {
    var term = dd_from(1.0);
    var s = dd_from(1.0);
    var k: i64 = 1;
    while k <= MAX_ITER_SERIES {
        term = dd_div(dd_mul_d(term, x), dd_add_d(dd_from(a), k));
        s = dd_add(s, term);
        if abs(term.hi) <= 1e-33 * abs(s.hi) {
            return s, 0;
        }
        k += 1;
    }
    return s, 8;
}

// The exponential of a log pair, as a pair of doubles m and k with the
// value m * 2^k. The caller multiplies before it scales.
fn scaled_exp_parts(logv: DD) -> DD, i64 {
    let k = floor(logv.hi / DD_LN2_HI) as i64;
    let ln2 = DD { hi: DD_LN2_HI, lo: DD_LN2_LO };
    let r = dd_sub(logv, dd_mul_d(ln2, k));
    let m, mk = dd_exp_parts(r);
    return m, k + mk;
}

// The Legendre continued fraction of the upper tail, in plain doubles.
// The modified Lentz form keeps the quotient stable. The bound is fixed.
fn cf_q(a: f64, x: f64) -> f64, i64 {
    var b = x + 1.0 - a;
    var c: f64 = 1e300;
    var d: f64 = 1.0 / b;
    var h = d;
    var i: i64 = 1;
    while i <= MAX_ITER_CF {
        let an = -i * (i - a);
        b += 2.0;
        d = an * d + b;
        if abs(d) < 1e-300 { d = 1e-300; }
        c = b + an / c;
        if abs(c) < 1e-300 { c = 1e-300; }
        d = 1.0 / d;
        let de = d * c;
        h = h * de;
        if abs(de - 1.0) <= 1e-17 {
            return h, 0;
        }
        i += 1;
    }
    return h, 8;
}

// The upper tail from the continued fraction, scaled by the prefactor.
fn cf_tail(a: f64, x: f64) -> f64, i64 {
    let lp = dd_log_prefactor(a, x);
    // the tail is below the smallest subnormal float
    if lp.hi < -800.0 { return 0.0, 0; }
    let m, k0 = scaled_exp_parts(lp);
    let h, c = cf_q(a, x);
    if c != 0 { return nan(), c; }
    let q = dd_scale(dd_mul_d(dd_mul_d(m, a), h), k0);
    if is_inf(q) { return nan(), 8; }
    return q, 0;
}

// The lower tail from the series, scaled by the prefactor.
fn series_tail(a: f64, x: f64) -> DD, i64 {
    let s, c = series_p(a, x);
    if c != 0 { return dd_from(nan()), c; }
    // the log of the tail is the log of the prefactor plus the log of the sum
    let lt = dd_add(dd_log_prefactor(a, x), dd_log(s));
    if lt.hi < -800.0 { return dd_from(0.0), 0; }
    return dd_exp(lt), 0;
}

// The saddle point branch of the incomplete gamma. It covers the large
// shapes near the argument, where the series and the fraction both need
// too many steps. The series of the terms b[n] gives the tail.
fn saddle_tail(a: f64, x: f64, upper: bool) -> f64, i64 {
    let delta = dd_div_d(dd_sub(dd_from(x), dd_from(a)), a);
    let big = dd_mul_d(dd_psi(delta), a);
    let bigd = dd_to_f64(big);
    let e = dd_to_f64(dd_exp(dd_neg(big)));
    // below the smallest subnormal the tail is zero
    if bigd > 745.0 || e <= 0.0 { return 0.0, 0; }
    let w = sqrt(2.0 * bigd);
    var y: f64[41];
    let sc = w / sqrt(2.0);
    if sc < 26.0 {
        let ec, cc = erfc(sc);
        if cc != 0 { return nan(), cc; }
        var ds: f64 = 0.0;
        if bigd != 0.0 {
            let st = dd_sqrt(big);
            ds = dd_to_f64(dd_sub(st, dd_from(sc)));
        }
        let hz = TWO_OVER_SQRT_PI * exp(-sc * sc) / ec;
        let i0 = sqrt(1.5707963267948966) * ec * exp(-hz * ds);
        y[0] = i0 / e;
    } else {
        let w2 = w * w;
        var pw: f64 = 1.0;
        var acc: f64 = 0.0;
        var k: i64 = 0;
        while k < ERFCA.len {
            acc += ERFCA[k] * pw;
            pw = pw / w2;
            k += 1;
        }
        y[0] = acc / w;
    }
    y[1] = 1.0;
    var n: i64 = 2;
    while n < 41 {
        var wp: f64 = 1.0;
        var j: i64 = 1;
        while j < n {
            wp = wp * w;
            j += 1;
        }
        y[n] = wp + (n - 1.0) * y[n - 2];
        n += 1;
    }
    let inv_t = 1.0 / sqrt(2.0 * a);
    var tp: f64 = 1.0;
    var ssum: f64 = 0.0;
    n = 0;
    while n < 41 {
        var bn = B_SAD[n];
        if !upper && n % 2 == 0 { bn = -bn; }
        if n == 0 {
            ssum += bn * y[0] * e;
        } else {
            ssum += bn * tp * y[n] * e;
        }
        tp = tp * inv_t;
        n += 1;
    }
    let fac = dd_to_f64(dd_exp(dd_neg(dd_stirling_s(a)))) / sqrt(PI);
    var r = fac * ssum;
    if !upper { r = -r; }
    if is_inf(r) || is_nan(r) { return nan(), 8; }
    return r, 0;
}

// The log gamma of one plus a tiny shape. The pair form above shifts to
// 16 and subtracts the logs, and the error of the shift drowns the tiny
// value. The series in a gives the value itself, so no digits are lost.
fn dd_lngamma_tiny(a: f64) -> DD {
    var s = DD { hi: LG1P_H[12], lo: LG1P_L[12] };
    var k: i64 = 11;
    while k >= 0 {
        s = dd_add(dd_mul_d(s, a), DD { hi: LG1P_H[k], lo: LG1P_L[k] });
        k -= 1;
    }
    return dd_mul_d(s, a);
}

// The upper tail for a tiny shape and a small argument. The tail 1 - P
// loses all its digits there, because P is within 1e-16 of 1. The form
// Q = (1 - w) - w a S keeps them. Here w = x^a / Gamma(a + 1) and S is the
// alternating series of (-x)^k / (k! (a + k)). The sum of 1 - w is minus
// expm1 of its log. The flag is false when the form does not apply.
fn small_upper(a: f64, x: f64) -> f64, bool {
    let u = dd_sub(dd_mul_d(dd_log_d(x), a), dd_lngamma_tiny(a));
    if abs(u.hi) >= 1e-3 { return 0.0, false; }
    // minus expm1(u) from its series; the terms fall below 1e-33 by k = 12
    var em = dd_from(0.0);
    var t = dd_from(1.0);
    var k: i64 = 1;
    while k <= 14 {
        t = dd_div_d(dd_mul(t, u), k);
        em = dd_add(em, t);
        k += 1;
    }
    let w = dd_add(dd_from(1.0), em);
    var term = dd_from(1.0);
    var ssum = dd_from(0.0);
    k = 1;
    while k <= 100 {
        term = dd_mul_d(dd_div_d(term, k), -x);
        let part = dd_div(term, dd_add_d(dd_from(a), k));
        ssum = dd_add(ssum, part);
        if abs(part.hi) <= 1e-34 { break; }
        k += 1;
    }
    let q = dd_sub(dd_neg(em), dd_mul(dd_mul_d(w, a), ssum));
    return dd_to_f64(q), true;
}

// The regularized incomplete gamma. The small tail always comes first,
// and the other tail is one minus it.
fn forward_gammainc(a: f64, x: f64, upper: bool) -> f64, i64 {
    if x == 0.0 {
        if upper { return 1.0, 0; }
        return 0.0, 0;
    }
    let delta = (x - a) / a;
    if a >= 2500.0 {
        if delta > 2.5 {
            let q, c = cf_tail(a, x);
            if c != 0 { return nan(), c; }
            if upper { return q, 0; }
            return 1.0 - q, 0;
        }
        if delta < -0.5 {
            let p, c = series_tail(a, x);
            if c != 0 { return nan(), c; }
            if upper { return dd_to_f64(dd_sub(dd_from(1.0), p)), 0; }
            return dd_to_f64(p), 0;
        }
        if delta > 0.0 {
            let q, c = saddle_tail(a, x, true);
            if c != 0 { return nan(), c; }
            if upper { return q, 0; }
            return 1.0 - q, 0;
        }
        let p, c = saddle_tail(a, x, false);
        if c != 0 { return nan(), c; }
        if upper { return 1.0 - p, 0; }
        return p, 0;
    }
    if x < a + 1.0 || x < 6.0 {
        if upper && a < 1e-3 {
            let qs, ok = small_upper(a, x);
            if ok { return qs, 0; }
        }
        let p, c = series_tail(a, x);
        if c != 0 { return nan(), c; }
        if upper { return dd_to_f64(dd_sub(dd_from(1.0), p)), 0; }
        return dd_to_f64(p), 0;
    }
    let q, c = cf_tail(a, x);
    if c != 0 { return nan(), c; }
    if upper { return q, 0; }
    return 1.0 - q, 0;
}

// The regularized lower incomplete gamma P(a, x).
fn gammainc(a: f64, x: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    if is_nan(x) { return nan(), 3; }
    if is_inf(x) {
        if x > 0.0 { return 1.0, 0; }
        return nan(), 5;
    }
    if x < 0.0 { return nan(), 5; }
    if a > MAX_SHAPE { return nan(), 5; }
    return forward_gammainc(a, x, false);
}

// The regularized upper incomplete gamma Q(a, x).
fn gammaincc(a: f64, x: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    if is_nan(x) { return nan(), 3; }
    if is_inf(x) {
        if x > 0.0 { return 0.0, 0; }
        return nan(), 5;
    }
    if x < 0.0 { return nan(), 5; }
    if a > MAX_SHAPE { return nan(), 5; }
    return forward_gammainc(a, x, true);
}

// ---- the incomplete beta ---------------------------------------------

// One step of the modified Lentz form, on pairs. The quotient aa joins
// the running values c and d.
fn lentz_step(aa: DD, c: DD, d: DD) -> DD, DD {
    let one = dd_from(1.0);
    var dn = dd_add(one, dd_mul(aa, d));
    if abs(dn.hi) < 1e-300 { dn = dd_from(1e-300); }
    var cn = dd_add(one, dd_div(aa, c));
    if abs(cn.hi) < 1e-300 { cn = dd_from(1e-300); }
    dn = dd_div(one, dn);
    return cn, dn;
}

// The continued fraction of the incomplete beta, in pairs. The count of
// steps comes back with the value. The bound is fixed.
fn betacf_dd(a: f64, b: f64, x: DD) -> DD, i64 {
    let one = dd_from(1.0);
    let sab, eab = two_sum(a, b);
    let sap, eap = two_sum(a, 1.0);
    let sam, eam = two_sum(a, -1.0);
    let qab = DD { hi: sab, lo: eab };
    let qap = DD { hi: sap, lo: eap };
    let qam = DD { hi: sam, lo: eam };
    var c = one;
    var d = dd_sub(one, dd_div(dd_mul(qab, x), qap));
    if abs(d.hi) < 1e-300 { d = dd_from(1e-300); }
    d = dd_div(one, d);
    var h = d;
    var m: i64 = 1;
    while m <= MAX_ITER_CF {
        let fm = m as f64;
        let m2 = 2.0 * fm;
        let num_e = dd_mul(dd_mul_d(dd_sub(dd_from(b), dd_from(fm)), fm), x);
        let sd, ed = two_sum(a, m2);
        let den_e = dd_mul(dd_add_d(qam, m2), DD { hi: sd, lo: ed });
        let c1, d1 = lentz_step(dd_div(num_e, den_e), c, d);
        c = c1;
        d = d1;
        h = dd_mul(h, dd_mul(d, c));
        let sn, en = two_sum(a, fm);
        let num_o = dd_neg(dd_mul(dd_mul(DD { hi: sn, lo: en }, dd_add_d(qab, fm)), x));
        let den_o = dd_mul(DD { hi: sd, lo: ed }, dd_add_d(qap, m2));
        let c2, d2 = lentz_step(dd_div(num_o, den_o), c, d);
        c = c2;
        d = d2;
        let de = dd_mul(d, c);
        h = dd_mul(h, de);
        if abs((de.hi - 1.0) + de.lo) < 1e-30 {
            return h, 0;
        }
        m += 1;
    }
    return h, 8;
}

// The small tail of the beta distribution at x in (0, 1). The result is
// the side (0 for the lower tail, 1 for the upper tail), the tail as a
// pair with its power of two, and the code. The tail that converges
// fast is the tail that the call computes.
fn beta_tail(a: f64, b: f64, x: f64) -> i64, DD, i64, i64 {
    let ys, ye = two_sum(1.0, -x);
    let y = DD { hi: ys, lo: ye };
    let lx = dd_log_d(x);
    let ly = dd_log(y);
    let lnb = dd_lnbeta(a, b);
    let logp = dd_sub(dd_add(dd_mul_d(lx, a), dd_mul_d(ly, b)), lnb);
    var side: i64 = 0;
    var cf = dd_from(0.0);
    var code: i64 = 0;
    var shape = a;
    if x < (a + 1.0) / (a + b + 2.0) {
        let h, c = betacf_dd(a, b, dd_from(x));
        cf = h;
        code = c;
    } else {
        side = 1;
        shape = b;
        let h, c = betacf_dd(b, a, y);
        cf = h;
        code = c;
    }
    if code != 0 { return side, dd_from(nan()), 0, code; }
    let mant, k = dd_exp_parts(logp);
    // A tiny shape would overflow the quotient before the power of two
    // brings it back. Scale the shape up by 2^600 and the power with it.
    if shape < 1e-100 {
        let tail = dd_div_d(dd_mul(mant, cf), shape * pow2_int(600));
        return side, tail, k + 600, 0;
    }
    let tail = dd_div_d(dd_mul(mant, cf), shape);
    return side, tail, k, 0;
}

// The tail I_x(a, b) of a tiny shape b, from the Gauss series
// x^a / B(a, b) times the sum of (1 - b)_n x^n / (n! (a + n)). For a tiny b
// the tail is as small as b, and one minus its complement holds none of its
// digits. The terms fall by the factor x, so the sum needs a bound. A sum
// that does not converge inside the bound gives the fault code 8.
fn beta_series_tail(a: f64, b: f64, xd: DD) -> f64, i64 {
    var t = dd_from(1.0);
    var ssum = dd_div_d(dd_from(1.0), a);
    var n: i64 = 1;
    var done = false;
    while n <= MAX_ITER_SERIES {
        t = dd_mul(dd_div_d(dd_mul_d(t, n - b), n), xd);
        let part = dd_div(t, dd_add_d(dd_from(a), n));
        ssum = dd_add(ssum, part);
        if abs(part.hi) <= 1e-33 * abs(ssum.hi) { done = true; break; }
        n += 1;
    }
    if !done { return nan(), 8; }
    let logp = dd_sub(dd_mul(dd_log(xd), dd_from(a)), dd_lnbeta(a, b));
    let mant, k = dd_exp_parts(logp);
    return dd_scale(dd_mul(mant, ssum), k), 0;
}

// The code of the arguments of the incomplete beta function. A shape at
// or below 0 and a probability outside the unit range are out of range.
fn check_beta_args(a: f64, b: f64, x: f64) -> i64 {
    let ca = check_shape(a);
    if ca != 0 { return ca; }
    let cb = check_shape(b);
    if cb != 0 { return cb; }
    if is_nan(x) { return 3; }
    if is_inf(x) { return 5; }
    if x < 0.0 || x > 1.0 { return 5; }
    if a > MAX_SHAPE || b > MAX_SHAPE { return 5; }
    return 0;
}

// The regularized incomplete beta function I_x(a, b), or its upper tail
// 1 - I_x(a, b). The small tail comes straight, and the other tail is
// one minus it, in pairs. A tiny shape makes the direct tail equal to
// one within 1e-15. If the wanted tail is then the other one, it comes
// from the series, because the difference holds none of its digits.
fn beta_value(a: f64, b: f64, x: f64, upper: bool) -> f64, i64 {
    if x <= 0.0 {
        if upper { return 1.0, 0; }
        return 0.0, 0;
    }
    if x >= 1.0 {
        if upper { return 0.0, 0; }
        return 1.0, 0;
    }
    let side, tail, k, code = beta_tail(a, b, x);
    if code != 0 { return nan(), code; }
    let direct = dd_scale(tail, k);
    // the direct tail is the wanted one
    if upper {
        if side == 1 { return direct, 0; }
    } else {
        if side == 0 { return direct, 0; }
    }
    // the wanted tail is one minus the direct tail
    if direct > 1.0 - 1e-15 {
        if upper {
            let ys, ye = two_sum(1.0, -x);
            return beta_series_tail(b, a, DD { hi: ys, lo: ye });
        }
        return beta_series_tail(a, b, dd_from(x));
    }
    let scaled = DD { hi: tail.hi * pow2_int(k), lo: tail.lo * pow2_int(k) };
    return dd_to_f64(dd_sub(dd_from(1.0), scaled)), 0;
}

// The regularized incomplete beta function I_x(a, b).
fn betainc(a: f64, b: f64, x: f64) -> f64, i64 {
    let c = check_beta_args(a, b, x);
    if c != 0 { return nan(), c; }
    return beta_value(a, b, x, false);
}

// The upper tail 1 - I_x(a, b) of the regularized incomplete beta
// function, with x exact. The distributions use it, because a caller
// that passes 1 - x would lose the digits of a small x.
fn betainc_upper(a: f64, b: f64, x: f64) -> f64, i64 {
    let c = check_beta_args(a, b, x);
    if c != 0 { return nan(), c; }
    return beta_value(a, b, x, true);
}

// ---- the inverses ----------------------------------------------------

// The standard normal quantile for p in (0, 1). It only gives a start.
fn norm_start(p: f64) -> f64 {
    var q = p;
    if p > 0.5 { q = 1.0 - p; }
    let r, c = erfcinv(2.0 * q);
    if c != 0 { return 0.0; }
    let z = -1.4142135623730951 * r;
    if p > 0.5 { return -z; }
    return z;
}

// The log of the tail that the call solves for. The lower tail below the
// switch comes from the series as a pair, so a tail near 1e-300 never
// underflows. The other cases take the log of the forward value.
fn log_tail_gamma(a: f64, x: f64, upper: bool) -> f64, i64 {
    if !upper && a < 2500.0 && (x < a + 1.0 || x < 6.0) {
        let s, c = series_p(a, x);
        if c != 0 { return nan(), c; }
        return dd_to_f64(dd_add(dd_log_prefactor(a, x), dd_log(s))), 0;
    }
    let v, c = forward_gammainc(a, x, upper);
    if c != 0 { return nan(), c; }
    if v <= 0.0 { return -1.0 / 0.0, 0; }
    return log(v), 0;
}

// The log of the density x^(a-1) exp(-x) / Gamma(a).
fn log_density_gamma(a: f64, x: f64) -> f64 {
    let t = dd_to_f64(dd_sub(dd_mul_d(dd_log_d(x), a - 1.0), dd_from(x)));
    let lg, c = lgamma_pos(a);
    return t - lg;
}

// Solve the tail of the incomplete gamma for a target log, in u = log x.
// The residual is monotone, so one bracket holds the root. A step that
// leaves the bracket falls back to a bisection step.
fn solve_gamma_tail(a: f64, target: f64, upper: bool) -> f64, i64 {
    let target_log = dd_to_f64(dd_log_d(target));
    var u0: f64 = 0.0;
    if upper {
        let z = -norm_start(target);
        let s = 1.0 - 1.0 / (9.0 * a) + z / (3.0 * sqrt(a));
        let x0 = a * s * s * s;
        if x0 > 0.0 && !is_inf(x0) { u0 = log(x0); } else { u0 = log(a); }
    } else {
        let lg, c = lgamma_pos(a);
        u0 = (target_log + log(a) + lg) / a;
    }
    if u0 < -740.0 { u0 = -740.0; }
    if u0 > 700.0 { u0 = 700.0; }
    var lo = u0 - 4.0;
    var hi = u0 + 4.0;
    var step: f64 = 4.0;
    var n: i64 = 0;
    // the bracket: the residual is below 0 at lo and above 0 at hi for the
    // lower tail, and the other way round for the upper tail
    while n < 60 {
        let flo, c1 = log_tail_gamma(a, exp(lo), upper);
        if c1 != 0 { return nan(), c1; }
        let fhi, c2 = log_tail_gamma(a, exp(hi), upper);
        if c2 != 0 { return nan(), c2; }
        var ok_lo = false;
        var ok_hi = false;
        if upper {
            ok_lo = flo - target_log >= 0.0;
            ok_hi = fhi - target_log <= 0.0;
        } else {
            ok_lo = flo - target_log <= 0.0;
            ok_hi = fhi - target_log >= 0.0;
        }
        if ok_lo && ok_hi { break; }
        step = step * 2.0;
        if !ok_lo { lo -= step; }
        if !ok_hi { hi += step; }
        if lo < -745.0 { lo = -745.0; }
        if hi > 709.0 { hi = 709.0; }
        if lo <= -745.0 && hi >= 709.0 { break; }
        n += 1;
    }
    var u = 0.5 * (lo + hi);
    var i: i64 = 0;
    while i < MAX_ITER_INVERSE {
        let x = exp(u);
        let lt, c = log_tail_gamma(a, x, upper);
        if c != 0 { return nan(), c; }
        let f = lt - target_log;
        if upper {
            if f > 0.0 { lo = u; } else { hi = u; }
        } else {
            if f > 0.0 { hi = u; } else { lo = u; }
        }
        let ld = log_density_gamma(a, x) - lt + u;
        var g: f64 = 0.0;
        if ld < 700.0 { g = exp(ld); }
        if upper { g = -g; }
        var un = 0.5 * (lo + hi);
        if g != 0.0 && !is_inf(g) {
            let t = u - f / g;
            if t > lo && t < hi && !is_nan(t) { un = t; }
        }
        if abs(un - u) <= 1e-16 * max(abs(un), 1.0) {
            u = un;
            break;
        }
        u = un;
        i += 1;
    }
    var xr = exp(u);
    // Polish in the value domain. The log of a tail near 1e-15 holds the
    // rounding of a number of size 35, and the value does not.
    if target > 1e-290 {
        var k: i64 = 0;
        while k < 2 {
            let v, c = forward_gammainc(a, xr, upper);
            if c != 0 { return nan(), c; }
            let dens = exp(log_density_gamma(a, xr));
            if dens <= 0.0 || is_inf(dens) || is_nan(dens) { break; }
            var xn = xr - (v - target) / dens;
            if upper { xn = xr + (v - target) / dens; }
            if !(xn > 0.0) || is_inf(xn) || abs(xn - xr) > 0.01 * xr { break; }
            xr = xn;
            k += 1;
        }
    }
    return xr, 0;
}

// The inverse of the lower regularized incomplete gamma.
fn gammaincinv(a: f64, p: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    let cp = check_prob(p);
    if cp != 0 { return nan(), cp; }
    if a > MAX_SHAPE { return nan(), 5; }
    if p == 0.0 { return 0.0, 0; }
    if p == 1.0 { return nan(), 8; }
    if p > 0.5 { return solve_gamma_tail(a, 1.0 - p, true); }
    return solve_gamma_tail(a, p, false);
}

// The inverse of the upper regularized incomplete gamma.
fn gammainccinv(a: f64, q: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    let cq = check_prob(q);
    if cq != 0 { return nan(), cq; }
    if a > MAX_SHAPE { return nan(), 5; }
    if q == 1.0 { return 0.0, 0; }
    if q == 0.0 { return nan(), 8; }
    if q > 0.5 { return solve_gamma_tail(a, 1.0 - q, false); }
    return solve_gamma_tail(a, q, true);
}

// The log of one plus a pair, for a pair above -1.
fn dd_log1p_dd(x: DD) -> DD {
    let s, e = two_sum(1.0, x.hi);
    let t = dd_add(DD { hi: s, lo: e }, dd_from(x.lo));
    if t.hi <= 0.0 { return dd_from(-1.0 / 0.0); }
    return dd_log(t);
}

// The logs of the two tails of the beta distribution and of its density
// at x. The tail that the fraction computes is exact in the log, and the
// other tail is the complement in pairs.
fn beta_log_ij(a: f64, b: f64, x: f64) -> DD, DD, DD, i64 {
    let ys, ye = two_sum(1.0, -x);
    let y = DD { hi: ys, lo: ye };
    let lx = dd_log_d(x);
    let ly = dd_log(y);
    let lnb = dd_lnbeta(a, b);
    let pref = dd_sub(dd_add(dd_mul_d(lx, a), dd_mul_d(ly, b)), lnb);
    var log_i = dd_from(0.0);
    var log_j = dd_from(0.0);
    if x < (a + 1.0) / (a + b + 2.0) {
        let cf, c = betacf_dd(a, b, dd_from(x));
        if c != 0 { return log_i, log_j, log_i, c; }
        log_i = dd_sub(dd_add(pref, dd_log(cf)), dd_log_d(a));
        log_j = dd_log1p_dd(dd_neg(dd_exp(log_i)));
    } else {
        let cf, c = betacf_dd(b, a, y);
        if c != 0 { return log_i, log_j, log_i, c; }
        log_j = dd_sub(dd_add(pref, dd_log(cf)), dd_log_d(b));
        log_i = dd_log1p_dd(dd_neg(dd_exp(log_j)));
    }
    let logpdf = dd_sub(dd_add(dd_mul_d(lx, a - 1.0), dd_mul_d(ly, b - 1.0)), lnb);
    return log_i, log_j, logpdf, 0;
}

// The start of the beta inverse. It is only a start, and the loop does
// the work.
fn beta_start(a: f64, b: f64, p: f64) -> f64 {
    let s = a + b;
    if a > 1.0 && b > 1.0 {
        let sd = sqrt(a * b / (s * s * (s + 1.0)));
        let z = norm_start(p);
        let skew = 2.0 * (b - a) * sqrt(s + 1.0) / ((s + 2.0) * sqrt(a * b));
        let x = a / s + sd * (z + skew * (z * z - 1.0) / 6.0);
        if x > 0.0 && x < 1.0 { return x; }
        return a / s;
    }
    let lb = dd_to_f64(dd_lnbeta(a, b));
    if p <= 0.5 {
        let v = (log(p * a) + lb) / a;
        if v < -1e-3 { return exp(max(v, -744.0)); }
    } else {
        let v = (log((1.0 - p) * b) + lb) / b;
        if v < -1e-3 { return 1.0 - exp(max(v, -744.0)); }
    }
    return 0.5;
}

// The inverse of the incomplete beta. The solver iterates on x with the
// log of the small tail as the residual. A geometric bisection step
// replaces every Newton step that leaves the bracket.
fn betaincinv(a: f64, b: f64, p: f64) -> f64, i64 {
    let ca = check_shape(a);
    if ca != 0 { return nan(), ca; }
    let cb = check_shape(b);
    if cb != 0 { return nan(), cb; }
    let cp = check_prob(p);
    if cp != 0 { return nan(), cp; }
    if a > MAX_SHAPE || b > MAX_SHAPE { return nan(), 5; }
    if p == 0.0 { return 0.0, 0; }
    if p == 1.0 { return 1.0, 0; }
    let upper = p > 0.5;
    var logt = dd_log_d(p);
    if upper { logt = dd_log_d(1.0 - p); }
    var x = beta_start(a, b, p);
    if !(x > 0.0 && x < 1.0) { x = 0.5; }
    var lo: f64 = 0.0;
    var hi: f64 = 1.0;
    var best_x = x;
    var best_f = 1.0 / 0.0;
    var last_f: f64 = 0.0;
    var it: i64 = 0;
    while it < MAX_ITER_INVERSE {
        let log_i, log_j, logpdf, c = beta_log_ij(a, b, x);
        if c != 0 { return nan(), c; }
        var f: f64 = 0.0;
        var lrat = dd_sub(log_i, logpdf);
        if upper {
            f = dd_to_f64(dd_sub(logt, log_j));
            lrat = dd_sub(log_j, logpdf);
        } else {
            f = dd_to_f64(dd_sub(log_i, logt));
        }
        last_f = f;
        if is_nan(f) { break; }
        if abs(f) < best_f {
            best_f = abs(f);
            best_x = x;
        }
        if abs(f) <= 4e-16 { break; }
        if f > 0.0 { hi = x; } else { lo = x; }
        var step: f64 = 0.0;
        if !is_nan(lrat.hi) && lrat.hi > -700.0 && lrat.hi < 700.0 {
            if x < 0.5 {
                let lr = dd_sub(lrat, dd_log_d(x));
                if lr.hi > -700.0 && lr.hi < 700.0 {
                    var du = -f * dd_to_f64(dd_exp(lr));
                    if !is_inf(du) && !is_nan(du) {
                        du = max(-50.0, min(50.0, du));
                        step = x * expm1_core(du);
                    }
                }
            } else {
                step = -f * dd_to_f64(dd_exp(lrat));
                if is_inf(step) || is_nan(step) { step = 0.0; }
            }
        }
        if step != 0.0 && abs(step) <= abs(x) * 2.220446049250313e-16 { break; }
        var cand: f64 = -1.0;
        if step != 0.0 {
            let t = x + step;
            if t > lo && t < hi { cand = t; }
        }
        if cand < 0.0 {
            var l = lo;
            if l <= 0.0 { l = 5e-324; }
            if hi > 8.0 * l {
                let m = sqrt(l) * sqrt(hi);
                if m > lo && m < hi { cand = m; } else { cand = 0.5 * (lo + hi); }
            } else {
                cand = 0.5 * (lo + hi);
            }
        }
        if cand == x || hi <= lo * 1.0000000000000002 { break; }
        x = cand;
        it += 1;
    }
    if best_x <= 5e-324 && last_f > 0.0 { return 0.0, 0; }
    return best_x, 0;
}
