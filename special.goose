    -0.5772156649015329, 0.8224670334241132, -0.40068563438653143, 0.27058080842778454, -0.20738555102867398, 0.1695571769974082, -0.1440498967688461, 0.12550966952474304, -0.11133426586956469, 0.1000994575127818, -0.09095401714582904, 0.083353840546109, -0.0769325164113522,
];
const LG1P_L: f64[13] = [
    4.942915152430645e-18, 1.520336175199238e-17, 2.250747042487504e-18, 1.1871280107138412e-17, -4.099767328621813e-18, 2.2393851330167238e-18, -9.623140085232555e-18, -2.5214685384672305e-18, -4.643990572582924e-18, 2.6102404859583283e-18, -8.306705457691885e-19, 2.963832603652642e-19, 3.2900356019181198e-18,
];

// ---- the layer of pairs of doubles -----------------------------------

// One pair holds a value with about 30 digits. hi carries the value and
// lo carries the rest.
struct DD { hi: f64, lo: f64 }

// The smallest normal value. A pair below it can still round to a
// subnormal result once.
const MIN_NORMAL: f64 = 2.2250738585072014e-308;

// The exact sum of two values. The pair p and e adds up to a + b.
fn two_sum(a: f64, b: f64) -> f64, f64 {
    let s = a + b;
    let bb = s - a;
    return s, (a - (s - bb)) + (b - bb);
}

fn dd_from(x: f64) -> DD { return DD { hi: x, lo: 0.0 }; }
fn dd_to_f64(a: DD) -> f64 { return a.hi + a.lo; }

fn dd_add(a: DD, b: DD) -> DD {
    let s, e = two_sum(a.hi, b.hi);
    if is_inf(s) { return DD { hi: s, lo: 0.0 }; }
    let t = e + a.lo + b.lo;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_add_d(a: DD, b: f64) -> DD {
    let s, e = two_sum(a.hi, b);
    if is_inf(s) { return DD { hi: s, lo: 0.0 }; }
    let t = e + a.lo;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_sub(a: DD, b: DD) -> DD {
    return dd_add(a, DD { hi: -b.hi, lo: -b.lo });
}

fn dd_neg(a: DD) -> DD { return DD { hi: -a.hi, lo: -a.lo }; }

fn dd_mul(a: DD, b: DD) -> DD {
    let p, e = two_prod(a.hi, b.hi);
    if is_inf(p) { return DD { hi: p, lo: 0.0 }; }
    let t = e + a.hi * b.lo + a.lo * b.hi;
    let h, l = two_sum(p, t);
    return DD { hi: h, lo: l };
}

fn dd_mul_d(a: DD, b: f64) -> DD {
    let p, e = two_prod(a.hi, b);
    if is_inf(p) { return DD { hi: p, lo: 0.0 }; }
    let t = e + a.lo * b;
    let h, l = two_sum(p, t);
    return DD { hi: h, lo: l };
}

fn dd_div(a: DD, b: DD) -> DD {
    let q1 = a.hi / b.hi;
    if is_inf(q1) { return DD { hi: q1, lo: 0.0 }; }
    var r = dd_sub(a, dd_mul(b, dd_from(q1)));
    let q2 = r.hi / b.hi;
    r = dd_sub(r, dd_mul(b, dd_from(q2)));
    let q3 = r.hi / b.hi;
    let s, e = two_sum(q1, q2);
    let t = e + q3 + r.lo / b.hi;
    let h, l = two_sum(s, t);
    return DD { hi: h, lo: l };
}

fn dd_div_d(a: DD, b: f64) -> DD { return dd_div(a, dd_from(b)); }

fn dd_sqrt(a: DD) -> DD {
    let x = sqrt(a.hi);
    let r = dd_sub(a, dd_mul(dd_from(x), dd_from(x)));
    let h, l = two_sum(x, r.hi / (2.0 * x));
    return DD { hi: h, lo: l };
}

// The value 2^k for a fixed range of k. The power call is exact for the
// powers of two, which the probes proved on both versions.
fn pow2_int(k: i64) -> f64 {
    if k < -1080 { return 0.0; }
    if k > 1080 { return 1.0 / 0.0; }
    return pow(2.0, k as f64);
}

// The pair m and e with x = m * 2^e and m in [1, 2) or m equal 0. The
// search runs on ten scale factors, so it ends in ten steps.
const EXP2_FACTORS: f64[10] = [
    1.3407807929942597e+154, 1.157920892373162e+77, 3.402823669209385e+38,
    1.8446744073709552e+19, 4294967296.0, 65536.0,
    256.0, 16.0, 4.0, 2.0,
];

fn frexp2(x: f64) -> f64, i64 {
    var m = x;
    var e: i64 = 0;
    if m != 0.0 && abs(m) < MIN_NORMAL {
        m = m * 18014398509481984.0;
        e = -54;
    }
    var k: i64 = 512;
    for f in EXP2_FACTORS {
        if abs(m) >= f {
            m = m / f;
            e += k;
        } else if abs(m) < 1.0 && abs(m) * f < 2.0 {
            m = m * f;
            e -= k;
        }
        k = k / 2;
    }
    return m, e;
}

// The value of the pair scaled by 2^k, rounded once.
fn dd_scale(a: DD, k: i64) -> f64 {
    return dd_to_f64(a) * pow2_int(k);
}

// The value of the pair scaled by 2^k, kept as a pair.
fn dd_scale_dd(a: DD, k: i64) -> DD {
    if k < -1180 { return dd_from(0.0); }
    let s = pow2_int(k);
    return DD { hi: a.hi * s, lo: a.lo * s };
}
// ---- input checks ----------------------------------------------------

// The checks of one argument. A NaN gives the NaN code, an infinity the
// infinity code. The order of the checks never changes.
fn check_scalar(x: f64) -> i64 {
    if is_nan(x) { return ERR_NAN; }
    if is_inf(x) { return ERR_INFINITY; }
    return OK;
}

// The checks of a shape. A shape at or below 0 is out of range.
fn check_shape(a: f64) -> i64 {
    if is_nan(a) { return ERR_NAN; }
    if is_inf(a) { return ERR_INFINITY; }
    if a <= 0.0 { return ERR_DOMAIN; }
    return OK;
}

// The checks of a probability. The end points 0 and 1 are valid inputs.
fn check_prob(p: f64) -> i64 {
    if is_nan(p) { return ERR_NAN; }
    if is_inf(p) { return ERR_DOMAIN; }
    if p < 0.0 || p > 1.0 { return ERR_DOMAIN; }
    return OK;
}

// ---- polynomial helpers ----------------------------------------------

// The Horner form of a coefficient table, highest coefficient first.
fn horner(c: const f64[:], z: f64) -> f64 {
    var r: f64 = 0.0;
    var i = c.len - 1;
    while i >= 0 {
        r = r * z + c[i];
        i -= 1;
    }
    return r;
}

// The Clenshaw form of a Chebyshev fit, highest coefficient first.
fn clenshaw(c: const f64[:], t: f64) -> f64 {
    var b1: f64 = 0.0;
    var b2: f64 = 0.0;
    var i = c.len - 1;
    while i >= 1 {
        let b0 = 2.0 * t * b1 - b2 + c[i];
        b2 = b1;
        b1 = b0;
        i -= 1;
    }
    return t * b1 - b2 + c[0];
}
