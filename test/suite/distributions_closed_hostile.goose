// Hostile input for the fourteen laws of the first tail group. A NaN gives the NaN fault, an infinity
// gives the infinity fault and a probability outside 0 to 1 gives the
// domain fault.
namespace suite;

import std;
import math;
import statistics from "../..";

fn run_distributions_closed_hostile() -> i64 {
    var bad: i64 = 0;
    let n0, kn0 = statistics::alpha_pdf(0.0 / 0.0, 1.5);
    chk_code(bad, "alpha a NaN point", kn0, 3);
    let zi0, kzi0 = statistics::alpha_cdf(1.0 / 0.0, 1.5);
    chk_code(bad, "alpha an infinite point", kzi0, 4);
    let p0, kp0 = statistics::alpha_ppf(1.5, 1.5);
    chk_code(bad, "alpha a probability above 1", kp0, 5);
    let n1, kn1 = statistics::fatiguelife_pdf(0.0 / 0.0, 0.7);
    chk_code(bad, "fatiguelife a NaN point", kn1, 3);
    let zi1, kzi1 = statistics::fatiguelife_cdf(1.0 / 0.0, 0.7);
    chk_code(bad, "fatiguelife an infinite point", kzi1, 4);
    let p1, kp1 = statistics::fatiguelife_ppf(1.5, 0.7);
    chk_code(bad, "fatiguelife a probability above 1", kp1, 5);
    let n2, kn2 = statistics::levy_pdf(0.0 / 0.0);
    chk_code(bad, "levy a NaN point", kn2, 3);
    let zi2, kzi2 = statistics::levy_cdf(1.0 / 0.0);
    chk_code(bad, "levy an infinite point", kzi2, 4);
    let p2, kp2 = statistics::levy_ppf(1.5);
    chk_code(bad, "levy a probability above 1", kp2, 5);
    let n3, kn3 = statistics::levy_l_pdf(0.0 / 0.0);
    chk_code(bad, "levy_l a NaN point", kn3, 3);
    let zi3, kzi3 = statistics::levy_l_cdf(1.0 / 0.0);
    chk_code(bad, "levy_l an infinite point", kzi3, 4);
    let p3, kp3 = statistics::levy_l_ppf(1.5);
    chk_code(bad, "levy_l a probability above 1", kp3, 5);
    let n4, kn4 = statistics::logistic_pdf(0.0 / 0.0);
    chk_code(bad, "logistic a NaN point", kn4, 3);
    let zi4, kzi4 = statistics::logistic_cdf(1.0 / 0.0);
    chk_code(bad, "logistic an infinite point", kzi4, 4);
    let p4, kp4 = statistics::logistic_ppf(1.5);
    chk_code(bad, "logistic a probability above 1", kp4, 5);
    let n5, kn5 = statistics::loglaplace_pdf(0.0 / 0.0, 2.5);
    chk_code(bad, "loglaplace a NaN point", kn5, 3);
    let zi5, kzi5 = statistics::loglaplace_cdf(1.0 / 0.0, 2.5);
    chk_code(bad, "loglaplace an infinite point", kzi5, 4);
    let p5, kp5 = statistics::loglaplace_ppf(1.5, 2.5);
    chk_code(bad, "loglaplace a probability above 1", kp5, 5);
    let n6, kn6 = statistics::lomax_pdf(0.0 / 0.0, 2.0);
    chk_code(bad, "lomax a NaN point", kn6, 3);
    let zi6, kzi6 = statistics::lomax_cdf(1.0 / 0.0, 2.0);
    chk_code(bad, "lomax an infinite point", kzi6, 4);
    let p6, kp6 = statistics::lomax_ppf(1.5, 2.0);
    chk_code(bad, "lomax a probability above 1", kp6, 5);
    let n7, kn7 = statistics::pareto_pdf(0.0 / 0.0, 2.5);
    chk_code(bad, "pareto a NaN point", kn7, 3);
    let zi7, kzi7 = statistics::pareto_cdf(1.0 / 0.0, 2.5);
    chk_code(bad, "pareto an infinite point", kzi7, 4);
    let p7, kp7 = statistics::pareto_ppf(1.5, 2.5);
    chk_code(bad, "pareto a probability above 1", kp7, 5);
    let n8, kn8 = statistics::powerlaw_pdf(0.0 / 0.0, 1.8);
    chk_code(bad, "powerlaw a NaN point", kn8, 3);
    let zi8, kzi8 = statistics::powerlaw_cdf(1.0 / 0.0, 1.8);
    chk_code(bad, "powerlaw an infinite point", kzi8, 4);
    let p8, kp8 = statistics::powerlaw_ppf(1.5, 1.8);
    chk_code(bad, "powerlaw a probability above 1", kp8, 5);
    let n9, kn9 = statistics::reciprocal_pdf(0.0 / 0.0, 1.0, 4.0);
    chk_code(bad, "reciprocal a NaN point", kn9, 3);
    let zi9, kzi9 = statistics::reciprocal_cdf(1.0 / 0.0, 1.0, 4.0);
    chk_code(bad, "reciprocal an infinite point", kzi9, 4);
    let p9, kp9 = statistics::reciprocal_ppf(1.5, 1.0, 4.0);
    chk_code(bad, "reciprocal a probability above 1", kp9, 5);
    let n10, kn10 = statistics::rdist_pdf(0.0 / 0.0, 3.0);
    chk_code(bad, "rdist a NaN point", kn10, 3);
    let zi10, kzi10 = statistics::rdist_cdf(1.0 / 0.0, 3.0);
    chk_code(bad, "rdist an infinite point", kzi10, 4);
    let p10, kp10 = statistics::rdist_ppf(1.5, 3.0);
    chk_code(bad, "rdist a probability above 1", kp10, 5);
    let n11, kn11 = statistics::skewcauchy_pdf(0.0 / 0.0, 0.4);
    chk_code(bad, "skewcauchy a NaN point", kn11, 3);
    let zi11, kzi11 = statistics::skewcauchy_cdf(1.0 / 0.0, 0.4);
    chk_code(bad, "skewcauchy an infinite point", kzi11, 4);
    let p11, kp11 = statistics::skewcauchy_ppf(1.5, 0.4);
    chk_code(bad, "skewcauchy a probability above 1", kp11, 5);
    let n12, kn12 = statistics::wrapcauchy_pdf(0.0 / 0.0, 0.6);
    chk_code(bad, "wrapcauchy a NaN point", kn12, 3);
    let zi12, kzi12 = statistics::wrapcauchy_cdf(1.0 / 0.0, 0.6);
    chk_code(bad, "wrapcauchy an infinite point", kzi12, 4);
    let p12, kp12 = statistics::wrapcauchy_ppf(1.5, 0.6);
    chk_code(bad, "wrapcauchy a probability above 1", kp12, 5);
    let n13, kn13 = statistics::kappa4_pdf(0.0 / 0.0, 0.3, 0.2);
    chk_code(bad, "kappa4 a NaN point", kn13, 3);
    let zi13, kzi13 = statistics::kappa4_cdf(1.0 / 0.0, 0.3, 0.2);
    chk_code(bad, "kappa4 an infinite point", kzi13, 4);
    let p13, kp13 = statistics::kappa4_ppf(1.5, 0.3, 0.2);
    chk_code(bad, "kappa4 a probability above 1", kp13, 5);
    // A random sweep: every answer with the code OK is finite.
    var st: u64 = 4711;
    for k in 0..tests_count() / 20 {
        let x = (rnd(st) % 801) as f64 / 100.0 - 4.0;
        let v0, c0 = statistics::alpha_cdf(x, 1.5);
        hostile_report(bad, c0 == 0 && v0 >= 0.0 && v0 <= 1.0, "alpha cdf", k, c0);
        let v1, c1 = statistics::fatiguelife_cdf(x, 0.7);
        hostile_report(bad, c1 == 0 && v1 >= 0.0 && v1 <= 1.0, "fatiguelife cdf", k, c1);
        let v2, c2 = statistics::levy_cdf(x);
        hostile_report(bad, c2 == 0 && v2 >= 0.0 && v2 <= 1.0, "levy cdf", k, c2);
        let v3, c3 = statistics::levy_l_cdf(x);
        hostile_report(bad, c3 == 0 && v3 >= 0.0 && v3 <= 1.0, "levy_l cdf", k, c3);
        let v4, c4 = statistics::logistic_cdf(x);
        hostile_report(bad, c4 == 0 && v4 >= 0.0 && v4 <= 1.0, "logistic cdf", k, c4);
        let v5, c5 = statistics::loglaplace_cdf(x, 2.5);
        hostile_report(bad, c5 == 0 && v5 >= 0.0 && v5 <= 1.0, "loglaplace cdf", k, c5);
        let v6, c6 = statistics::lomax_cdf(x, 2.0);
        hostile_report(bad, c6 == 0 && v6 >= 0.0 && v6 <= 1.0, "lomax cdf", k, c6);
        let v7, c7 = statistics::pareto_cdf(x, 2.5);
        hostile_report(bad, c7 == 0 && v7 >= 0.0 && v7 <= 1.0, "pareto cdf", k, c7);
        let v8, c8 = statistics::powerlaw_cdf(x, 1.8);
        hostile_report(bad, c8 == 0 && v8 >= 0.0 && v8 <= 1.0, "powerlaw cdf", k, c8);
        let v9, c9 = statistics::reciprocal_cdf(x, 1.0, 4.0);
        hostile_report(bad, c9 == 0 && v9 >= 0.0 && v9 <= 1.0, "reciprocal cdf", k, c9);
        let v10, c10 = statistics::rdist_cdf(x, 3.0);
        hostile_report(bad, c10 == 0 && v10 >= 0.0 && v10 <= 1.0, "rdist cdf", k, c10);
        let v11, c11 = statistics::skewcauchy_cdf(x, 0.4);
        hostile_report(bad, c11 == 0 && v11 >= 0.0 && v11 <= 1.0, "skewcauchy cdf", k, c11);
    }
    return bad;
}
