    let v488, c488 = statistics::gumbel_l_pdf(1e+308, 1e+308);
    chk_val(bad, "gumbel_l pdf 1e+308 1e+308", v488, c488, 0.36787944117144233, 1e-11);
    let v489, c489 = statistics::gumbel_l_pdf(-1e+308, 1e+308);
    chk_val(bad, "gumbel_l pdf -1e+308 1e+308", v489, c489, 0.0, 1e-11);
    let _v490, c490 = statistics::gumbel_l_pdf(1e+308, -1e+308);
    chk_code(bad, "gumbel_l pdf 1e+308 -1e+308 undefined", c490, 7);
    let _v491, c491 = statistics::gumbel_l_pdf(1.0, 0.0, 0.0);
    chk_code(bad, "gumbel_l scale 0", c491, 5);
    let _v492, c492 = statistics::gumbel_l_cdf(1.0, 0.0, -1.0);
    chk_code(bad, "gumbel_l scale negative", c492, 5);
    let _v493, c493 = statistics::gumbel_l_ppf(1.5);
    chk_code(bad, "gumbel_l ppf above 1", c493, 5);
    let _v494, c494 = statistics::gumbel_l_ppf(0.0 / 0.0);
    chk_code(bad, "gumbel_l ppf nan", c494, 3);
    let _v495, c495 = statistics::gumbel_l_sf(1.0 / 0.0);
    chk_code(bad, "gumbel_l x infinity", c495, 4);
    let _v496, c496 = statistics::rayleigh_ppf(0.5, 0.0, 1.7e308);
    chk_code(bad, "rayleigh ppf overflow", c496, 8);
    let _v497, c497 = statistics::gumbel_r_ppf(1e-300, 0.0, 1e308);
    chk_code(bad, "gumbel_r ppf overflow", c497, 8);
    let _v498, c498 = statistics::gumbel_l_ppf(1.0 - 1e-16, 0.0, 1e308);
    chk_code(bad, "gumbel_l ppf overflow", c498, 8);
    let _v499, c499 = statistics::rayleigh_mean(1e308, 1e308);
    chk_code(bad, "rayleigh mean overflow", c499, 8);
    let v500, c500 = statistics::rayleigh_ppf(0.0);
    chk_val(bad, "rayleigh ppf 0", v500, c500, 0.0, 1e-11);
    let _v501, c501 = statistics::rayleigh_ppf(1.0);
    chk_code(bad, "rayleigh ppf 1", c501, 5);
    let _v502, c502 = statistics::gumbel_r_ppf(0.0);
    chk_code(bad, "gumbel_r ppf 0", c502, 5);
    return bad;
}
