    chk_val(bad, "genpareto cdf -1", v117, c117, 0.0, 1e-10);
    let v118, c118 = statistics::genpareto_sf(-1.0, -0.5);
    chk_val(bad, "genpareto sf -1", v118, c118, 1.0, 1e-10);
    let v119, c119 = statistics::genpareto_pdf(3.0, -0.5);
    chk_val(bad, "genpareto pdf 3", v119, c119, 0.0, 1e-10);
    let v120, c120 = statistics::genpareto_cdf(3.0, -0.5);
    chk_val(bad, "genpareto cdf 3", v120, c120, 1.0, 1e-10);
    let v121, c121 = statistics::genpareto_sf(3.0, -0.5);
    chk_val(bad, "genpareto sf 3", v121, c121, 0.0, 1e-10);
    let v122, c122 = statistics::genpareto_ppf(0.1, -0.5);
    chk_val(bad, "genpareto ppf 0.1", v122, c122, 0.10263340389897241, 1e-10);
    let v123, c123 = statistics::genpareto_ppf(0.5, -0.5);
    chk_val(bad, "genpareto ppf 0.5", v123, c123, 0.585786437626905, 1e-10);
    let v124, c124 = statistics::genpareto_ppf(0.9, -0.5);
    chk_val(bad, "genpareto ppf 0.9", v124, c124, 1.3675444679663242, 1e-10);
    let v125, c125 = statistics::genpareto_mean(-0.5);
    chk_val(bad, "genpareto mean", v125, c125, 0.6666666666666666, 1e-10);
    let v126, c126 = statistics::genpareto_var(-0.5);
    chk_val(bad, "genpareto var", v126, c126, 0.2222222222222222, 1e-10);
    let v127, c127 = statistics::genpareto_skew(-0.5);
    chk_val(bad, "genpareto skew", v127, c127, 0.565685424949238, 1e-10);
    let v128, c128 = statistics::genpareto_kurt(-0.5);
    chk_val(bad, "genpareto kurt", v128, c128, -0.6000000000000001, 1e-10);
    return bad;
}
