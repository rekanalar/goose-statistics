// The answers of SciPy 1.18.1 for the exact and distance tests. The
// generator test/make_exact_vectors.py writes this file. It holds the
// documented rows, seeded random tables and samples with ties, and the
// answers of the Kolmogorov-Smirnov dispatchers.
namespace suite;

import std;
import statistics from "../..";

fn xtrow(bad: i64&, rc: statistics::TestResult, c: i64, stat: f64, p: f64, ts: f64, tp: f64, name: u8[:]) {
    if c == 0 && near_tol(rc.statistic, stat, ts) && near_tol(rc.pvalue, p, tp) { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", rc.statistic, " ", rc.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

// The seeded draw of bws_test above the exact bound: the same seed gives the same
// p-value, and the p-value lies within 0.03 of the exact one.
fn xbwsmc(bad: i64&, xs: const f64[:], ys: const f64[:], stat: f64, p: f64) {
    var r1 = rng { s: 11 };
    var r2 = rng { s: 11 };
    let a, ca = statistics::bws_test(xs, ys, r1);
    let b, cb = statistics::bws_test(xs, ys, r2);
    if ca == 0 && cb == 0 && a.pvalue == b.pvalue && near_tol(a.statistic, stat, 1e-12) && abs(a.pvalue - p) < 0.03 { return; }
    bad += 1;
    if bad <= 12 { print("FAIL bws seeded draw got ", a.pvalue, " ", b.pvalue, " want ", p, "\n"); }
}

fn xarow(bad: i64&, g: const f64[:], sz: const i64[:], variant: i64, stat: f64, p: f64, crit: const f64[:], name: u8[:]) {
    var out: f64[>..] = [];
    let r, c = statistics::anderson_ksamp(out, g, sz, variant);
    if c == 0 && near_tol(r.statistic, stat, 1e-11) && near_tol(r.pvalue, p, 1e-9) && near_list(out[..], crit, 1e-13) { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

fn xksrow(bad: i64&, xs: const f64[:], ys: const f64[:], alt: i64, stat: f64, p: f64, loc: f64, sign: f64, name: u8[:]) {
    var out: f64[>..] = [];
    let r, c = statistics::kstest_2samp(out, xs, ys, alt);
    if c == 0 && near_tol(r.statistic, stat, 1e-12) && near_tol(r.pvalue, p, 1e-12) && out.len == 2
        && out[0] == loc && out[1] == sign && is_nan(r.df) && is_nan(r.df2) { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

fn xks1row(bad: i64&, xs: const f64[:], family: i64, pp: const f64[:], alt: i64, stat: f64, p: f64, loc: f64, sign: f64, name: u8[:]) {
    var out: f64[>..] = [];
    let r, c = statistics::kstest(out, xs, family, pp, alt);
    if c == 0 && near_tol(r.statistic, stat, 1e-12) && near_tol(r.pvalue, p, 1e-12) && out.len == 2
        && out[0] == loc && out[1] == sign && is_nan(r.df) && is_nan(r.df2) { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

fn xprow(bad: i64&, d: const f64[:], columns: i64, ranked: bool, pr: const f64[:], method: i64, stat: f64, p: f64, used: f64, name: u8[:]) {
    let r, c = statistics::page_trend_test(d, columns, ranked, pr, method);
    if c == 0 && near_tol(r.statistic, stat, 1e-12) && near_tol(r.pvalue, p, 1e-11) && r.df == used { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " df ", r.df, " code ", c, " want ", stat, " ", p, "\n"); }
}

fn run_exact_vectors() -> i64 {
    var bad: i64 = 0;
    {
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 2.247332874877474, 0.03345870971679689, 1e-12, 1e-09, "barnard oracle two-sided"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 0.03488925934746368, 0.03196459926398076, 1e-12, 1e-09, "boschloo oracle two-sided"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_LESS); xtrow(bad, r, c, 2.247332874877474, 1.0, 1e-12, 1e-09, "barnard oracle less"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_LESS); xtrow(bad, r, c, 0.9972612526792093, 0.9883427185178026, 1e-12, 1e-09, "boschloo oracle less"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_GREATER); xtrow(bad, r, c, 2.247332874877474, 0.016786917914384802, 1e-12, 1e-09, "barnard oracle greater"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_GREATER); xtrow(bad, r, c, 0.03488925934746368, 0.01598229963199038, 1e-12, 1e-09, "boschloo oracle greater"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let pp: f64[2] = [3.5, 1.5]; let r, c = statistics::cramervonmises(xs[..], statistics::FAMILY_NORMAL, pp[..]); xtrow(bad, r, c, 0.02081411830801615, 0.9983318698471384, 1e-12, 1e-09, "cramervonmises oracle"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; let r, c = statistics::cramervonmises_2samp(xs[..], ys[..], statistics::MW_EXACT); xtrow(bad, r, c, 0.546875, 0.032012432012432014, 1e-12, 1e-12, "cvm2 oracle exact"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; let r, c = statistics::cramervonmises_2samp(xs[..], ys[..], statistics::MW_ASYMPTOTIC); xtrow(bad, r, c, 0.546875, 0.029770401611030284, 1e-12, 1e-12, "cvm2 oracle asymptotic"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; let tt: f64[0] = []; let r, c = statistics::epps_singleton_2samp(xs[..], ys[..], tt[..]); xtrow(bad, r, c, 5.013687598904544, 0.28589594331337015, 1e-12, 1e-09, "epps oracle"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; var rg = rng { s: 7 }; let r, c = statistics::bws_test(xs[..], ys[..], rg, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 2.978111049107143, 0.03154623154623155, 1e-12, 1e-12, "bws oracle two-sided"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; var rg = rng { s: 7 }; let r, c = statistics::bws_test(xs[..], ys[..], rg, statistics::ALT_LESS); xtrow(bad, r, c, -2.978111049107143, 0.015384615384615385, 1e-12, 1e-12, "bws oracle less"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; var rg = rng { s: 7 }; let r, c = statistics::bws_test(xs[..], ys[..], rg, statistics::ALT_GREATER); xtrow(bad, r, c, -2.978111049107143, 0.9846930846930847, 1e-12, 1e-12, "bws oracle greater"); }
        { let g: f64[24] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9, 3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0, 1.2, 2.5, 2.2, 3.1, 1.8, 2.9, 2.4, 3.3]; let sz: i64[3] = [8, 8, 8]; let cr: f64[7] = [0.44925883860929594, 1.3052766952966366, 1.9434183976444794, 2.576965691583343, 3.4163485553218895, 4.072100430724998, 5.564191013989369]; xarow(bad, g[..], sz[..], statistics::KSAMP_MIDRANK, 5.518090763382168, 0.0010495357151611717, cr[..], "anderson oracle midrank"); }
        { let g: f64[24] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9, 3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0, 1.2, 2.5, 2.2, 3.1, 1.8, 2.9, 2.4, 3.3]; let sz: i64[3] = [8, 8, 8]; let cr: f64[7] = [0.44925883860929594, 1.3052766952966366, 1.9434183976444794, 2.576965691583343, 3.4163485553218895, 4.072100430724998, 5.564191013989369]; xarow(bad, g[..], sz[..], statistics::KSAMP_RIGHT, 5.432977778355046, 0.0011501345058158967, cr[..], "anderson oracle right"); }
        { let g: f64[24] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9, 3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0, 1.2, 2.5, 2.2, 3.1, 1.8, 2.9, 2.4, 3.3]; let sz: i64[3] = [8, 8, 8]; let cr: f64[7] = [0.44925883860929594, 1.3052766952966366, 1.9434183976444794, 2.576965691583343, 3.4163485553218895, 4.072100430724998, 5.564191013989369]; xarow(bad, g[..], sz[..], statistics::KSAMP_CONTINUOUS, 5.432977778355046, 0.0011501345058158967, cr[..], "anderson oracle continuous"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let ys: f64[8] = [3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]; xksrow(bad, xs[..], ys[..], statistics::ALT_TWO_SIDED, 0.625, 0.08702408702408701, 3.8, 1.0, "kstest_2samp oracle"); }
        { let xs: f64[8] = [2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]; let pp: f64[2] = [3.5, 1.5]; xks1row(bad, xs[..], statistics::FAMILY_NORMAL, pp[..], statistics::ALT_TWO_SIDED, 0.1430611921955091, 0.9880479270584139, 1.9, -1.0, "kstest oracle"); }
        { let r, c = statistics::poisson_means_test(10.0, 2.0, 18.0, 2.5); xtrow(bad, r, c, -0.9484873498302991, 0.355227490108269, 1e-12, 1e-09, "poisson_means oracle"); }
        { let d: f64[24] = [2.1, 3.9, 1.2, 3.4, 5.2, 2.5, 1.9, 4.8, 2.2, 5.6, 6.1, 3.1, 4.4, 5.5, 1.8, 3.8, 4.1, 2.9, 2.7, 6.6, 2.4, 4.9, 5.0, 3.3]; let pr: f64[0] = []; xprow(bad, d[..], 3, false, pr[..], statistics::PAGE_EXACT, 90.0, 0.9479184527892085, 1.0, "page oracle exact"); }
        { let d: f64[24] = [2.1, 3.9, 1.2, 3.4, 5.2, 2.5, 1.9, 4.8, 2.2, 5.6, 6.1, 3.1, 4.4, 5.5, 1.8, 3.8, 4.1, 2.9, 2.7, 6.6, 2.4, 4.9, 5.0, 3.3]; let pr: f64[0] = []; xprow(bad, d[..], 3, false, pr[..], statistics::PAGE_ASYMPTOTIC, 90.0, 0.9331927987311419, 2.0, "page oracle asymptotic"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_TWO_SIDED, true); xtrow(bad, r, c, 2.247332874877474, 0.03345870971679689, 1e-12, 1e-09, "barnard 7 3 2 8 two-sided True"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_TWO_SIDED, false); xtrow(bad, r, c, 2.6173006971659856, 0.030815124511718757, 1e-12, 1e-09, "barnard 7 3 2 8 two-sided False"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 0.03488925934746368, 0.03196459926398076, 1e-12, 1e-09, "boschloo 7 3 2 8 two-sided"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_LESS, true); xtrow(bad, r, c, 2.247332874877474, 1.0, 1e-12, 1e-09, "barnard 7 3 2 8 less True"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_LESS, false); xtrow(bad, r, c, 2.6173006971659856, 1.0, 1e-12, 1e-09, "barnard 7 3 2 8 less False"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_LESS); xtrow(bad, r, c, 0.9972612526792093, 0.9883427185178026, 1e-12, 1e-09, "boschloo 7 3 2 8 less"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_GREATER, true); xtrow(bad, r, c, 2.247332874877474, 0.016786917914384802, 1e-12, 1e-09, "barnard 7 3 2 8 greater True"); }
        { let r, c = statistics::barnard_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_GREATER, false); xtrow(bad, r, c, 2.6173006971659856, 0.01598229963199038, 1e-12, 1e-09, "barnard 7 3 2 8 greater False"); }
        { let r, c = statistics::boschloo_exact(7.0, 3.0, 2.0, 8.0, statistics::ALT_GREATER); xtrow(bad, r, c, 0.03488925934746368, 0.01598229963199038, 1e-12, 1e-09, "boschloo 7 3 2 8 greater"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_TWO_SIDED, true); xtrow(bad, r, c, -1.8943380760602064, 0.06815343273153582, 1e-12, 1e-09, "barnard 7 12 8 3 two-sided True"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_TWO_SIDED, false); xtrow(bad, r, c, -2.018932132718121, 0.06815343273153582, 1e-12, 1e-09, "barnard 7 12 8 3 two-sided False"); }
        { let r, c = statistics::boschloo_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 0.06406796601699151, 0.06821830932319489, 1e-12, 1e-09, "boschloo 7 12 8 3 two-sided"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_LESS, true); xtrow(bad, r, c, -1.8943380760602064, 0.034076716365767874, 1e-12, 1e-09, "barnard 7 12 8 3 less True"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_LESS, false); xtrow(bad, r, c, -2.018932132718121, 0.034076716365767874, 1e-12, 1e-09, "barnard 7 12 8 3 less False"); }
        { let r, c = statistics::boschloo_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_LESS); xtrow(bad, r, c, 0.06406796601699151, 0.034109154661597446, 1e-12, 1e-09, "boschloo 7 12 8 3 less"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_GREATER, true); xtrow(bad, r, c, -1.8943380760602064, 1.0, 1e-12, 1e-09, "barnard 7 12 8 3 greater True"); }
        { let r, c = statistics::barnard_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_GREATER, false); xtrow(bad, r, c, -2.018932132718121, 1.0, 1e-12, 1e-09, "barnard 7 12 8 3 greater False"); }
        { let r, c = statistics::boschloo_exact(7.0, 12.0, 8.0, 3.0, statistics::ALT_GREATER); xtrow(bad, r, c, 0.9895302348825588, 0.9771215347573191, 1e-12, 1e-09, "boschloo 7 12 8 3 greater"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_TWO_SIDED, true); xtrow(bad, r, c, 1.8225863590257527, 0.070148380862763, 1e-12, 1e-09, "barnard 74 31 43 32 two-sided True"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_TWO_SIDED, false); xtrow(bad, r, c, 1.8197405688188515, 0.0879442127683584, 1e-12, 1e-09, "barnard 74 31 43 32 two-sided False"); }
        { let r, c = statistics::boschloo_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 0.048312210086912236, 0.0711281286030935, 1e-12, 1e-09, "boschloo 74 31 43 32 two-sided"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_LESS, true); xtrow(bad, r, c, 1.8225863590257527, 1.0, 1e-12, 1e-09, "barnard 74 31 43 32 less True"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_LESS, false); xtrow(bad, r, c, 1.8197405688188515, 1.0, 1e-12, 1e-09, "barnard 74 31 43 32 less False"); }
        { let r, c = statistics::boschloo_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_LESS); xtrow(bad, r, c, 0.9759961281714722, 0.9665032229005569, 1e-12, 1e-09, "boschloo 74 31 43 32 less"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_GREATER, true); xtrow(bad, r, c, 1.8225863590257527, 0.04691595404276872, 1e-12, 1e-09, "barnard 74 31 43 32 greater True"); }
        { let r, c = statistics::barnard_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_GREATER, false); xtrow(bad, r, c, 1.8197405688188515, 0.07613626462554106, 1e-12, 1e-09, "barnard 74 31 43 32 greater False"); }
        { let r, c = statistics::boschloo_exact(74.0, 31.0, 43.0, 32.0, statistics::ALT_GREATER); xtrow(bad, r, c, 0.048312210086912236, 0.03556406430154675, 1e-12, 1e-09, "boschloo 74 31 43 32 greater"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_TWO_SIDED, true); xtrow(bad, r, c, -1.6903085094570334, 0.14111328125, 1e-12, 1e-09, "barnard 0 5 3 4 two-sided True"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_TWO_SIDED, false); xtrow(bad, r, c, -3.3541019662496847, 0.12500000000000003, 1e-12, 1e-09, "barnard 0 5 3 4 two-sided False"); }
        { let r, c = statistics::boschloo_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_TWO_SIDED); xtrow(bad, r, c, 0.15909090909090912, 0.14005952019606813, 1e-12, 1e-09, "boschloo 0 5 3 4 two-sided"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_LESS, true); xtrow(bad, r, c, -1.6903085094570334, 0.11688155728623674, 1e-12, 1e-09, "barnard 0 5 3 4 less True"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_LESS, false); xtrow(bad, r, c, -3.3541019662496847, 0.06350038198776976, 1e-12, 1e-09, "barnard 0 5 3 4 less False"); }
        { let r, c = statistics::boschloo_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_LESS); xtrow(bad, r, c, 0.15909090909090912, 0.07002976009803406, 1e-12, 1e-09, "boschloo 0 5 3 4 less"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_GREATER, true); xtrow(bad, r, c, -1.6903085094570334, 1.0, 1e-12, 1e-09, "barnard 0 5 3 4 greater True"); }
        { let r, c = statistics::barnard_exact(0.0, 5.0, 3.0, 4.0, statistics::ALT_GREATER, false); xtrow(bad, r, c, -3.3541019662496847, 1.0, 1e-12, 1e-09, "barnard 0 5 3 4 greater False"); }
