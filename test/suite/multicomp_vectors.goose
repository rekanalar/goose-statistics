// The answers of SciPy 1.18.1 for tukey_hsd, dunnett, bayes_mvs and
// mvsdist. The generator test/make_multicomp_vectors.py writes this file.
// SciPy draws the Dunnett p-value with a randomized quasi Monte Carlo of
// about 1.5e-4 error, so the Dunnett rows use looser bounds.
namespace suite;

import std;
import statistics from "../..";

// A p-value or a statistic within a relative bound and an absolute bound.
fn mrow_near(a: f64, e: f64, rel: f64, ab: f64) -> bool {
    return abs(a - e) <= rel * abs(e) + ab;
}

fn trow(bad: i64&, groups: const f64[:], sizes: const i64[:], level: f64, equal_var: bool, want: const f64[:], name: u8[:]) {
    var out: f64[>..] = [];
    let n, c = statistics::tukey_hsd(out, groups, sizes, level, equal_var);
    var ok = c == 0 && out.len == want.len && n * 4 == want.len;
    if ok {
        for i in 0..want.len {
            var rel: f64 = 1e-10;
            var ab: f64 = 1e-12;
            if i % 4 == 1 { ab = 1e-14; }
            if i % 4 != 1 { ab = 1e-12 * (1.0 + abs(want[i])); }
            if !mrow_near(out[i], want[i], rel, ab) { ok = false; }
        }
    }
    if ok { return; }
    bad += 1;
    print("FAIL tukey ", name, " code ", c, "\n");
}

fn drow(bad: i64&, groups: const f64[:], sizes: const i64[:], control: i64, alt: i64, level: f64, want: const f64[:], name: u8[:]) {
    var out: f64[>..] = [];
    let n, c = statistics::dunnett(out, groups, sizes, control, alt, level);
    var ok = c == 0 && out.len == want.len && n * 4 == want.len;
    if ok {
        for i in 0..want.len {
            let col = i % 4;
            if col == 0 && !mrow_near(out[i], want[i], 1e-12, 1e-12) { ok = false; }
            if col == 1 && !mrow_near(out[i], want[i], 0.0, 1e-3) { ok = false; }
            if col >= 2 {
                if abs(want[i]) > 1.0e300 {
                    if out[i] != want[i] { ok = false; }
                } else if !mrow_near(out[i], want[i], 0.0, 5e-3 * (1.0 + abs(want[i]))) { ok = false; }
            }
        }
    }
    if ok { return; }
    bad += 1;
    print("FAIL dunnett ", name, " code ", c, "\n");
}

fn brow(bad: i64&, xs: const f64[:], level: f64, want: const f64[:], name: u8[:]) {
    let r, c = statistics::bayes_mvs(xs, level);
    var ok = c == 0;
    if ok {
        let got: f64[9] = [r.mean, r.mean_interval.low, r.mean_interval.high, r.variance, r.variance_interval.low, r.variance_interval.high, r.deviation, r.deviation_interval.low, r.deviation_interval.high];
        for i in 0..9 { if !near_tol(got[i], want[i], 1e-9) { ok = false; } }
    }
    if ok { return; }
    bad += 1;
    print("FAIL bayes_mvs ", name, " code ", c, "\n");
}

fn mrow(bad: i64&, xs: const f64[:], gaussian: bool, want: const f64[:], name: u8[:]) {
    let d, c = statistics::mvsdist(xs);
    var ok = c == 0 && d.gaussian == gaussian;
    if ok {
        let got: f64[9] = [d.mean, d.mean_scale, d.mean_df, d.variance, d.variance_scale, d.variance_shape, d.deviation, d.deviation_scale, d.deviation_shape];
        for i in 0..9 { if !near_tol(got[i], want[i], 1e-9) { ok = false; } }
    }
    if ok { return; }
    bad += 1;
    print("FAIL mvsdist ", name, " code ", c, "\n");
}

