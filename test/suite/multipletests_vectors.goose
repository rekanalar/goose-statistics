// The answers of statsmodels 0.15.0 and SciPy 1.18.1 for the
// multiple-test corrections. The generator
// test/make_multipletests_vectors.py writes this file.
// It holds the numbers and the checks that use them.
namespace suite;

import std;
import statistics from "../..";

fn arow(bad: i64&, ps: const f64[:], method: i64, want: const f64[:], name: u8[:]) {
    var out: f64[>..] = [];
    let n, c = statistics::multipletests(out, ps, method);
    var ok = c == 0 && n == want.len && out.len == n;
    if ok {
        for i in 0..n { if !near_tol(out[i], want[i], 1e-13) { ok = false; } }
    }
    if ok { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " code ", c, " n ", n, "\n"); }
}

fn frow(bad: i64&, ps: const f64[:], method: i64, want: const f64[:], name: u8[:]) {
    var out: f64[>..] = [];
    let n, c = statistics::false_discovery_control(out, ps, method);
    var ok = c == 0 && n == want.len && out.len == n;
    if ok {
        for i in 0..n { if !near_tol(out[i], want[i], 1e-13) { ok = false; } }
    }
    if ok { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " code ", c, " n ", n, "\n"); }
}

fn crow(bad: i64&, ps: const f64[:], method: i64, w: const f64[:], stat: f64, p: f64, df: f64, tol: f64, name: u8[:]) {
    let r, c = statistics::combine_pvalues(ps, method, w);
    var ok = c == 0 && near_tol(r.statistic, stat, tol) && near_tol(r.pvalue, p, tol);
    if method == statistics::COMBINE_FISHER { ok = ok && r.df == df; }
    if ok { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

