// The answers of SciPy 1.18.1 for the normality tests. The
// generator test/make_normality_vectors.py writes this file.
// It holds numbers only. The Anderson-Darling p-value is the
// asymptotic rule applied to the sequential sum.
namespace suite;

import std;
import statistics from "../..";

fn nrow(bad: i64&, r: statistics::TestResult, c: i64, stat: f64, p: f64, tol: f64, name: u8[:]) {
    var ok = c == 0 && near_tol(r.statistic, stat, tol) && near_tol(r.pvalue, p, tol);
    if ok { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

fn run_normality_vectors() -> i64 {
    var bad: i64 = 0;
    { let r, c = statistics::skewtest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 0); nrow(bad, r, c, 0.18964323837234598, 0.8495887026717367, 1e-13, "skewtest"); } // two-sided
    { let r, c = statistics::skewtest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 1); nrow(bad, r, c, 0.18964323837234598, 0.5752056486641317, 1e-13, "skewtest"); } // less
    { let r, c = statistics::skewtest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 2); nrow(bad, r, c, 0.18964323837234598, 0.42479435133586835, 1e-13, "skewtest"); } // greater
    { let r, c = statistics::kurtosistest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 0); nrow(bad, r, c, -1.2823982121365567, 0.19970299106588685, 1e-13, "kurtosistest"); } // two-sided
    { let r, c = statistics::kurtosistest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 1); nrow(bad, r, c, -1.2823982121365567, 0.09985149553294342, 1e-13, "kurtosistest"); } // less
    { let r, c = statistics::kurtosistest([1.1, 2.3, 3.7, 4.2, 5.9, 6.1, 7.4, 8.8, 2.0, 2.9, 3.1, 5.5, 6.6, 7.2, 9.1, 9.9], 2); nrow(bad, r, c, -1.2823982121365567, 0.9001485044670565, 1e-13, "kurtosistest"); } // greater
