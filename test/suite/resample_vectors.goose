// The answers of SciPy 1.18.1 for the resampling calls. The generator
// test/make_resample_vectors.py writes this file. It holds the numbers
// and the checks that use them.
namespace suite;

import std;
import math;
import statistics from "../..";

// The list of a literal.
fn rv_list(vals: const f64[:]) -> f64[>..] {
    var out: f64[>..] = [];
    for v in vals { out.push(v); }
    return out;
}

// The mean of the first half minus the mean of the second half.
fn rv_diff(s: const f64[:]) -> f64 {
    let h = s.len / 2;
    return mean_of(s[0..h]) - mean_of(s[h..s.len]);
}

// The Pearson correlation of the two halves.
fn rv_corr(s: const f64[:]) -> f64 {
    let h = s.len / 2;
    let mx = mean_of(s[0..h]);
    let my = mean_of(s[h..s.len]);
    var sxy: f64 = 0.0;
    var sxx: f64 = 0.0;
    var syy: f64 = 0.0;
    for i in 0..h {
        sxy += (s[i] - mx) * (s[h + i] - my);
        sxx += (s[i] - mx) * (s[i] - mx);
        syy += (s[h + i] - my) * (s[h + i] - my);
    }
    return sxy / sqrt(sxx * syy);
}

fn rv_ttest_p(s: const f64[:]) -> f64 {
    let r, c = statistics::ttest_1samp(s, 0.0);
    return r.pvalue;
}

fn run_resample_vectors() -> i64 {
    var bad: i64 = 0;
    let a = rv_list([2.1, 3.4, 1.9, 5.6, 4.4, 3.8, 2.7, 4.9]);
    let b = rv_list([3.9, 5.2, 4.8, 6.1, 5.5, 4.1, 6.6, 5.0]);
    var ab: f64[>..] = [];
    for x in a[..] { ab.push(x); }
    for x in b[..] { ab.push(x); }
    let two: i64[2] = [8, 8];
    let one: i64[1] = [8];
    let boot: f64[999] = [3.1, 3.375, 4.0375, 4.275, 2.8125, 3.2625, 3.7874999999999996, 2.9625, 4.25, 3.4499999999999997, 3.35, 4.075, 4.5, 2.95, 4.5125, 3.05, 3.9000000000000004, 4.7125, 3.125, 2.9, 3.5999999999999996, 3.9625, 3.1125, 3.3375000000000004, 3.625, 4.6875, 3.425, 4.3, 3.1374999999999997, 3.5, 3.05, 3.4875, 4.225, 4.275, 2.7875, 3.8499999999999996, 3.5, 3.25, 3.7625, 3.8125, 3.2125000000000004, 2.9250000000000003, 3.7125, 3.7125, 3.6125, 3.4875000000000003, 3.2625, 4.0, 3.9875000000000003, 3.9625, 3.325, 4.074999999999999, 2.875, 3.9625000000000004, 3.625, 4.05, 3.3, 4.0125, 3.7625, 4.175000000000001, 4.275, 4.0375, 3.4, 3.825, 2.9625000000000004, 3.425, 4.0625, 3.6875, 4.0875, 3.8625000000000003, 3.3374999999999995, 4.050000000000001, 3.475, 2.9625, 3.8125, 3.7249999999999996, 3.7625, 3.475, 4.05, 3.725, 3.2874999999999996, 3.6624999999999996, 3.6374999999999997, 2.9625, 3.5625, 4.125, 3.65, 2.9875, 3.1750000000000003, 3.6875, 4.25, 3.7875, 3.625, 3.6125, 2.2750000000000004, 3.3625000000000003, 3.1625, 4.1, 3.7, 3.9124999999999996, 3.1750000000000003, 3.2249999999999996, 3.8375, 3.7125000000000004, 3.95, 3.0375, 2.875, 4.4375, 3.325, 3.525, 4.275, 3.75, 2.775, 3.25, 3.075, 3.4375, 2.9375, 2.95, 3.025, 3.65, 4.199999999999999, 3.7625, 3.0250000000000004, 3.4375, 2.9375, 4.3375, 3.1375, 4.1875, 3.8375, 3.3125000000000004, 3.9, 3.4625000000000004, 3.925, 3.8875, 2.8625, 4.325, 3.45, 3.5374999999999996, 3.8125000000000004, 3.8125, 3.6500000000000004, 4.1875, 3.0375, 3.3625, 3.5625, 3.7, 3.4, 3.9375, 3.2125, 3.3375000000000004, 4.1875, 3.6625000000000005, 3.7125, 4.2875, 3.7125000000000004, 3.65, 3.0749999999999997, 3.325, 3.275, 3.8625, 2.975, 4.449999999999999, 3.0375, 3.0, 3.6, 3.7625, 3.75, 3.9875, 4.225, 3.2875, 3.3125, 3.5625, 3.05, 3.7624999999999997, 3.5125, 3.6875, 3.875, 3.55, 3.825, 3.3249999999999997, 3.775, 3.2125000000000004, 4.0625, 3.4625000000000004, 3.2375, 3.9000000000000004, 4.2625, 3.225, 3.4000000000000004, 3.4250000000000003, 3.025, 