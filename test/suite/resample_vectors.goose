0375, 3.7375, 3.5, 2.9625000000000004, 3.125, 4.0625, 3.775, 3.4499999999999997, 3.25, 3.8625000000000003, 3.3125, 3.675, 3.4125, 3.375, 3.675, 3.4875000000000003, 4.375, 4.475, 4.475, 3.5625, 3.575, 3.6125, 3.3, 3.0875000000000004, 3.925, 3.8875, 3.8, 3.5125, 3.6125000000000003, 3.3, 2.9, 4.2, 2.8125, 3.625, 3.3625, 3.5, 3.7125000000000004, 2.5, 3.675, 3.1750000000000003, 3.55, 3.3875, 4.0375, 3.4625, 4.025, 3.9875000000000003, 3.175, 3.6625, 3.425, 3.6625, 3.5, 3.6125, 3.275, 3.1375, 3.975, 3.4375, 3.8125, 4.1125, 3.475, 3.3125, 3.425, 2.925, 3.7125, 4.025, 3.725, 3.725, 3.6875, 3.6875, 3.15, 3.8125, 3.9375, 4.550000000000001, 3.3, 3.625, 3.6375, 3.2375, 3.425, 3.25, 3.95, 3.0375000000000005, 3.9625, 4.112500000000001, 3.8000000000000003, 4.2875, 3.125, 3.725, 3.5124999999999997, 3.45, 3.5375, 3.55, 3.5125, 3.65, 3.6125, 4.075, 3.35, 3.9000000000000004, 3.25, 2.725, 3.125, 3.6375, 4.05, 3.3375000000000004, 3.7124999999999995, 4.2125, 3.7, 2.775, 2.8625, 3.3, 3.25, 3.625, 3.0250000000000004, 3.7, 3.675, 3.825, 3.625, 3.45, 4.7625, 3.425, 3.7375000000000003, 3.5125, 3.6624999999999996, 4.175, 3.8125, 4.0375, 3.7, 3.6250000000000004, 3.3625, 2.85, 3.9250000000000003, 3.975, 3.8249999999999997, 3.175, 3.5375, 3.825, 3.0125, 4.1375, 3.425, 3.4875000000000003, 3.4875, 3.725, 2.575, 3.75, 3.8, 4.512499999999999, 3.525, 3.3375000000000004, 3.85, 3.4875, 3.1625, 4.025, 3.7625, 3.9125, 2.6875, 3.5875000000000004, 3.225, 2.6125000000000003, 3.5999999999999996, 4.275, 3.5625, 3.3625, 3.3499999999999996, 3.8874999999999997, 3.875, 4.325, 3.4125, 2.7625, 3.0625, 3.3, 4.074999999999999, 4.1125, 3.325, 3.8125, 4.0375, 3.8125, 3.7750000000000004, 4.0125, 2.9749999999999996, 3.4125, 3.7125, 3.5125, 3.55, 3.425, 3.7, 3.475, 3.3375000000000004, 4.0, 3.3625000000000003, 3.3125, 3.0625, 3.2125, 3.8375000000000004, 3.625, 3.175, 3.5250000000000004, 3.7125000000000004, 2.675, 3.8875, 3.4375, 3.1, 3.3500000000000005, 3.0250000000000004, 3.125, 3.0250000000000004, 3.4750000000000005, 4.0, 3.1375, 3.525, 2.7249999999999996, 3.1625, 3.8625, 3.45, 3.4125000000000005, 3.45, 3.4000000000000004, 4.125, 3.0875000000000004, 3.7125, 3.1624999999999996, 3.5, 3.8874999999999997, 4.15, 2.725, 3.7875, 3.575, 3.9, 3.8249999999999997, 3.2249999999999996, 4.35, 3.1875, 3.1625, 4.0125, 3.6375, 2.85, 3.6375, 3.375, 3.5625, 3.7749999999999995, 4.2625, 3.7625, 3.1875, 3.7750000000000004, 3.1375, 3.95, 3.5, 3.975, 3.0875, 3.375, 2.8499999999999996, 3.8375, 3.0, 4.299999999999999, 3.5875000000000004, 4.225, 3.1375, 4.0625, 3.425, 4.5, 3.6500000000000004, 3.1875, 3.7, 3.0, 3.725, 3.375, 3.3875, 3.4375, 3.0250000000000004, 4.525, 3.95, 3.5625, 3.8625000000000003, 4.2375, 3.5, 3.6374999999999997, 4.3, 3.5125, 4.0625, 3.1, 3.625, 3.1125, 4.4125, 2.6500000000000004, 4.125, 3.8375, 3.5125, 3.9625, 3.5375, 3.7375, 3.775, 4.0249999999999995, 3.8375, 3.0, 3.1, 3.6374999999999997, 3.3125, 3.1125000000000003, 3.375, 3.6750000000000003, 4.0, 3.5625, 3.3125, 3.8, 2.85, 3.1875, 3.7750000000000004, 2.75, 4.25, 3.1625, 3.9125, 3.9625000000000004, 3.2874999999999996, 2.8875, 3.8499999999999996, 3.5875000000000004, 3.7750000000000004, 3.4375, 3.3875, 4.0375, 3.7875000000000005, 3.7875, 2.6125, 4.0375, 3.4875, 3.5125, 3.6125, 4.0875, 2.85, 3.8499999999999996, 3.275, 3.075, 3.25, 3.5875, 3.1125, 3.95, 3.0, 3.225, 2.95, 3.4875, 4.1875, 3.7125000000000004, 3.525, 3.825, 3.6125, 3.75, 3.625, 3.5125, 3.5625, 2.9125, 4.025, 3.95, 3.8625, 4.1125, 3.1875, 3.55, 3.725, 3.6375, 3.8, 3.6125000000000003, 4.3375, 4.1375, 4.8375, 3.8875, 3.5, 2.8875, 3.2750000000000004, 3.125, 2.9375, 3.9625, 4.6625, 3.75, 3.7625, 4.3875, 3.45, 3.9250000000000003, 3.3375000000000004, 3.15, 3.9000000000000004, 3.575, 3.5125, 4.025, 3.6875, 3.2125000000000004, 4.375, 3.5250000000000004, 3.3125, 4.0375, 3.825, 3.1, 2.6875, 3.2, 3.4125, 3.1375, 2.8625, 3.3625, 4.275, 4.0625, 4.387499999999999, 2.6875, 2.8875, 3.85, 3.075, 3.425, 3.5625, 3.5, 3.3625000000000003, 3.775, 2.7, 3.65, 3.075, 3.775, 4.2875, 3.3375000000000004, 4.2875, 3.425, 3.3875, 3.0, 3.825, 4.075, 3.45, 3.6375, 3.0500000000000003, 3.9875000000000003, 2.975, 3.7750000000000004, 4.65, 3.2249999999999996, 3.8375, 3.525, 3.4000000000000004, 3.6375, 3.5, 3.4875, 3.9000000000000004, 3.975, 4.449999999999999, 3.2375, 3.975, 3.8375, 4.1875, 3.1125, 3.45, 3.0125, 4.0, 4.7125, 4.012499999999999, 3.7624999999999997, 3.3375000000000004, 3.525, 3.5, 3.3, 3.3000000000000003, 3.0625, 3.9625, 3.825, 3.1, 2.85, 3.5375, 3.9625000000000004, 3.1000000000000005, 3.825, 3.3125, 3.175, 3.225, 3.1000000000000005, 3.3625, 3.325, 3.8249999999999997, 3.55, 3.3249999999999997, 2.95, 3.85, 4.0125, 4.6875, 4.175000000000001, 4.050000000000001, 3.375, 3.7375000000000003, 3.475, 4.199999999999999, 3.1750000000000003, 2.8625, 3.3125, 3.75, 3.8375, 3.2375, 4.3375, 3.175, 3.15, 3.875, 3.5624999999999996, 3.65, 3.9000000000000004, 3.05, 3.3875, 3.925, 3.1875, 3.9375, 3.9625, 3.0125, 3.575, 3.0625, 4.0125, 3.075, 3.95, 3.575, 2.9625000000000004, 3.45, 3.5125, 2.9, 3.0875000000000004, 3.8375000000000004, 3.4125, 3.9124999999999996, 3.5625, 3.8375, 3.7625, 4.4125, 3.675, 2.825, 4.1, 3.45, 4.15, 3.6375, 2.5250000000000004, 3.0, 3.9375, 3.8875, 3.8375000000000004, 3.1625, 3.8500000000000005, 2.9625, 3.6375, 3.425, 3.25, 3.525, 4.199999999999999, 3.1125, 3.4499999999999997, 3.0625, 4.2375, 3.65, 3.875, 3.4250000000000003, 3.95, 3.525, 3.7625, 3.3875, 3.45, 3.6125000000000003, 3.3625000000000003, 3.85, 3.2750000000000004, 4.262499999999999, 3.6, 4.3875, 3.1875, 3.8875, 3.2, 3.4875, 4.125, 4.275, 3.625, 4.1375, 2.5875, 3.4125, 3.6125000000000003, 4.1125, 3.75, 3.5625, 3.6375, 3.3625000000000003, 3.175, 3.825, 3.6500000000000004, 3.8, 3.275, 3.3375, 3.375, 3.875, 3.475, 3.0250000000000004, 3.85, 4.125, 2.8625, 3.25, 3.125, 3.6625000000000005, 3.25, 3.8, 3.5, 4.0375, 3.5625, 3.8, 3.375, 3.975, 3.8125, 3.4125, 4.0375, 3.9125, 3.7249999999999996, 2.7125000000000004, 3.1, 3.3500000000000005, 3.0625, 2.7750000000000004, 3.8375, 3.8, 3.0, 3.1875, 3.4875, 3.225, 2.8625000000000003, 3.7375, 3.5875000000000004];
    let theta = 3.6;
    let ahat = 0.006489651899869487;
    let z0 = 0.03011419991126472;

    // The jackknife acceleration and the bias term of the BCa interval.
    let ga, ca = statistics::rs_accel(a[..]) { s => mean_of(s) };
    check(bad, ca == 0 && near_tol(ga, ahat, 1e-11), "bca, the acceleration of the jackknife");
    let gz, cz = statistics::rs_bias(boot[..], theta);
    check(bad, cz == 0 && near_tol(gz, z0, 1e-13), "bca, the bias term");

    // The three intervals of one fixed list of bootstrap values.
    let lo1, hi1, c1 = statistics::rs_interval(boot[..], theta, 0.0, 0.95, statistics::ALT_TWO_SIDED, statistics::INTERVAL_PERCENTILE);
    check(bad, c1 == 0 && near_tol(lo1, 2.775, 1e-13) && near_tol(hi1, 4.4137499999999985, 1e-13), "percentile interval, the fixed list");
    let lo2, hi2, c2 = statistics::rs_interval(boot[..], theta, 0.0, 0.95, statistics::ALT_TWO_SIDED, statistics::INTERVAL_BASIC);
    check(bad, c2 == 0 && near_tol(lo2, 2.7862500000000017, 1e-12) && near_tol(hi2, 4.425000000000001, 1e-12), "basic interval, the fixed list");
    let lo3, hi3, c3 = statistics::rs_interval(boot[..], theta, ahat, 0.95, statistics::ALT_TWO_SIDED, statistics::INTERVAL_BCA);
    check(bad, c3 == 0 && near_tol(lo3, 2.8125, 1e-12) && near_tol(hi3, 4.475, 1e-12), "bca interval, the fixed list");
    let lo4, hi4, c4 = statistics::rs_interval(boot[..], theta, ahat, 0.9, statistics::ALT_GREATER, statistics::INTERVAL_BCA);
    check(bad, c4 == 0 && near_tol(lo4, 3.05, 1e-12) && hi4 > 1e300, "bca interval, one-sided greater");
    let lo5, hi5, c5 = statistics::rs_interval(boot[..], theta, 0.0, 0.9, statistics::ALT_LESS, statistics::INTERVAL_PERCENTILE);
    check(bad, c5 == 0 && near_tol(hi5, 4.1625, 1e-13) && lo5 < -1e300, "percentile interval, one-sided less");

    // The exact permutation tests. All splits are listed, so no draw is made.
    var r0 = rng { s: 1 };
    var nul: f64[>..] = [];
    let exact = statistics::ResampleMethod { kind: statistics::RESAMPLE_PERMUTATION, resamples: 1000000, .. };
    let t1, k1 = statistics::permutation_test(nul, ab[..], two[..], exact, statistics::ALT_TWO_SIDED, r0) { s => rv_diff(s) };
    check(bad, k1 == 0 && nul.len == 12870 && near_tol(t1.pvalue, 0.019735819735819737, 1e-13) && near_tol(t1.statistic, -1.5500000000000003, 1e-12), "permutation, all 12870 splits");
    let t2, k2 = statistics::permutation_test(nul, ab[..], two[..], exact, statistics::ALT_LESS, r0) { s => rv_diff(s) };
    check(bad, k2 == 0 && near_tol(t2.pvalue, 0.009867909867909868, 1e-13), "permutation, the less side");
    var d: f64[8];
    for i in 0..8 { d[i] = a[i] - b[i]; }
    let sgn = statistics::ResampleMethod { kind: statistics::RESAMPLE_PERMUTATION, resamples: 1000, permutation: statistics::PERMUTE_SAMPLES, .. };
    let t3, k3 = statistics::permutation_test(nul, d[..], one[..], sgn, statistics::ALT_TWO_SIDED, r0) { s => mean_of(s) };
    check(bad, k3 == 0 && nul.len == 256 && near_tol(t3.pvalue, 0.0078125, 1e-13), "permutation, the sign flips");
    var p5: f64[10];
    for i in 0..5 { p5[i] = a[i]; p5[5 + i] = b[i]; }
    let five: i64[2] = [5, 5];
    let prs = statistics::ResampleMethod { kind: statistics::RESAMPLE_PERMUTATION, resamples: 20000, permutation: statistics::PERMUTE_PAIRINGS, .. };
    let t4, k4 = statistics::permutation_test(nul, p5[..], five[..], prs, statistics::ALT_TWO_SIDED, r0) { s => rv_corr(s) };
    check(bad, k4 == 0 && nul.len == 14400 && near_tol(t4.pvalue, 0.03333333333333333, 1e-12) && near_tol(t4.statistic, 0.8985893830749764, 1e-12), "permutation, the pairings");
    var p4: f64[8];
    for i in 0..4 { p4[i] = a[i]; p4[4 + i] = b[i]; }
    let four: i64[2] = [4, 4];
    let swp = statistics::ResampleMethod { kind: statistics::RESAMPLE_PERMUTATION, resamples: 1000, permutation: statistics::PERMUTE_SAMPLES, .. };
    let t5, k5 = statistics::permutation_test(nul, p4[..], four[..], swp, statistics::ALT_TWO_SIDED, r0) { s => rv_diff(s) };
    check(bad, k5 == 0 && nul.len == 16 && near_tol(t5.pvalue, 0.125, 1e-12), "permutation, the swaps of two samples");

    // The seeded bootstrap. The oracle is a SciPy run of 400000 resamples.
    // The Monte Carlo error of the endpoint of 9999 resamples stays
    // below 0.05, about 0.1 standard errors of the mean.
    var r1 = rng { s: 3 };
    var bo: f64[>..] = [];
    let bpm = statistics::ResampleMethod { resamples: 9999, interval: statistics::INTERVAL_PERCENTILE, .. };
    let br1, bc1 = statistics::bootstrap(bo, a[..], one[..], bpm, 0.95, statistics::ALT_TWO_SIDED, r1) { s => mean_of(s) };
    check(bad, bc1 == 0 && bo.len == 9999 && abs(br1.interval.low - 2.75) < 0.05 && abs(br1.interval.high - 4.4625) < 0.05
        && abs(br1.standard_error - 0.4398181633104662) < 0.02, "bootstrap percentile, seeded against the large run");
    var r2 = rng { s: 4 };
    let bbm = statistics::ResampleMethod { resamples: 9999, interval: statistics::INTERVAL_BASIC, .. };
    let br2, bc2 = statistics::bootstrap(bo, a[..], one[..], bbm, 0.95, statistics::ALT_TWO_SIDED, r2) { s => mean_of(s) };
    check(bad, bc2 == 0 && abs(br2.interval.low - 2.7375) < 0.05 && abs(br2.interval.high - 4.45) < 0.05, "bootstrap basic, seeded against the large run");
    var r3 = rng { s: 5 };
    let bam = statistics::ResampleMethod { resamples: 9999, interval: statistics::INTERVAL_BCA, .. };
    let br3, bc3 = statistics::bootstrap(bo, a[..], one[..], bam, 0.95, statistics::ALT_TWO_SIDED, r3) { s => mean_of(s) };
    check(bad, bc3 == 0 && abs(br3.interval.low - 2.7625) < 0.05 && abs(br3.interval.high - 4.475) < 0.05, "bootstrap bca, seeded against the large run");

    // The seeded Monte Carlo test against a normal null of mean 3 and
    // deviation 1.5. The error of a p-value of 9999 draws stays below 0.02.
    var r4 = rng { s: 6 };
    let mcm = statistics::ResampleMethod { kind: statistics::RESAMPLE_MONTE_CARLO, resamples: 9999, .. };
    let np: f64[2] = [3.0, 1.5];
    let m1, mk1 = statistics::monte_carlo_test(nul, a[..], statistics::FAMILY_NORMAL, np[..], mcm, statistics::ALT_TWO_SIDED, r4) { s => mean_of(s) };
    check(bad, mk1 == 0 && nul.len == 9999 && abs(m1.pvalue - 0.25811935470161324) < 0.02 && near_tol(m1.statistic, theta, 1e-12), "monte carlo, the two-sided p-value");
    let m2, mk2 = statistics::monte_carlo_test(nul, a[..], statistics::FAMILY_NORMAL, np[..], mcm, statistics::ALT_GREATER, r4) { s => mean_of(s) };
    check(bad, mk2 == 0 && abs(m2.pvalue - 0.12920717698205755) < 0.02, "monte carlo, the greater side");
    let ue: f64[2] = [0.0, 6.0];
    let m3, mk3 = statistics::monte_carlo_test(nul, a[..], statistics::FAMILY_UNIFORM, ue[..], mcm, statistics::ALT_TWO_SIDED, r4) { s => mean_of(s) };
    check(bad, mk3 == 0 && m3.pvalue > 0.1 && m3.pvalue <= 1.0, "monte carlo, a uniform null");

    // The power of the one-sample t test. The exact value comes from the
    // noncentral t distribution. The error of 20000 draws stays below 0.015.
    var r5 = rng { s: 7 };
    let pn: f64[2] = [0.5, 1.0];
    let pw, pk = statistics::power(statistics::FAMILY_NORMAL, pn[..], 20, 0.05, 20000, r5) { s => rv_ttest_p(s) };
    check(bad, pk == 0 && abs(pw - 0.564504418439021) < 0.015, "power, the one-sample t test");

    // The estimators of the Sobol indices on fixed evaluation lists.
    let fa = [0.03419276725318417, 1.3597475403099617, 1.2247210785859324, -0.5103070767876675, -0.2979695111064471, -0.5273841930334252, 0.5697263575719601, -0.056064439045617594];
    let fb = [0.7468856162565439, -1.8473247989741095, 1.5665487746995206, -0.09643216015562055, 0.6803784532741461, -0.13656633397682774, -0.3790985670748533, 0.46311015859758675];
    let fab = [0.824513527530113, -0.20252987069345152, -0.15278617857019708, 0.685698610809258, -0.8703406419471712, -1.5143835037313955, 0.39498186274953, -0.6705658236878794, -1.9203405901180286, -0.8140536639453595, -0.467597558892747, -1.1932024774322612, -1.4924638840630338, 0.03663782694480509, 0.8972492567277476, -0.23313207796045685, -0.7435960295088448, 0.3849938087479083, 0.7172358071943838, -0.3000105984884774, 0.5446678079208929, 1.0428754765829538, -0.20695643620832396, -0.8135155419815723];
    let fi: f64[3] = [0.235644454924156, 0.017011378451566583, 0.16437258181310568];
    let ft: f64[3] = [0.7306297616188704, 1.2406303866348543, 0.5598912707103662];
    var first: f64[>..] = [];
    var total: f64[>..] = [];
    let sn, sk = statistics::sobol_from_evaluations(first, total, fa[..], fb[..], fab[..], 3);
    check(bad, sk == 0 && sn == 3 && near_list(first[..], fi[..], 1e-12) && near_list(total[..], ft[..], 1e-12), "sobol, the estimators on fixed lists");
    return bad;
}
