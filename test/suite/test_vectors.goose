// The answers of SciPy for the hypothesis tests. test/make_test_vectors.py
// writes this file. It holds numbers only.
namespace suite;

import std;
import math;
import statistics from "../..";

fn vrow(bad: i64&, r: statistics::TestResult, c: i64, stat: f64, p: f64, df: f64, ptol: f64, name: u8[:]) {
    var ok = c == 0 && near_tol(r.statistic, stat, 1e-14) && near_tol(r.pvalue, p, ptol);
    if !is_nan(df) { ok = ok && near_tol(r.df, df, 1e-13); }
    if ok { return; }
    bad += 1;
    if bad <= 12 { print("FAIL ", name, " got ", r.statistic, " ", r.pvalue, " code ", c, " want ", stat, " ", p, "\n"); }
}

